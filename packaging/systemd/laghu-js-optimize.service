[Unit]
Description=Laghu JavaScript optimization worker
After=local-fs.target

[Service]
Type=simple
User=laghu
Group=laghu
ExecStartPre=/usr/bin/laghu-js-optimize --init /run/laghu/javascript.queue /var/cache/laghu/images
ExecStart=/usr/bin/laghu-js-optimize --serve /run/laghu/javascript.queue /var/cache/laghu/images
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/laghu /var/cache/laghu

[Install]
WantedBy=multi-user.target
