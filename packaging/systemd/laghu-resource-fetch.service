[Unit]
Description=Laghu external font stylesheet fetch service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=laghu
Group=laghu
ExecStartPre=/usr/bin/laghu-resource-fetch --init /run/laghu/fonts.queue /var/cache/laghu/images /etc/laghu/font-providers.conf
ExecStart=/usr/bin/laghu-resource-fetch --serve /run/laghu/fonts.queue /var/cache/laghu/images /etc/laghu/font-providers.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/laghu /var/cache/laghu

[Install]
WantedBy=multi-user.target
