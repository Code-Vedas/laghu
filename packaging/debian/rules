# LICENSE file in the root directory of this source tree.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

%:
	dh $@ --with apache2,nginx

override_dh_auto_configure:
	dh_auto_configure --builddirectory=debian/build -- \
		-DLAGHU_WITH_VIPS=ON -DLAGHU_BUILD_TESTS=OFF \
		-DCMAKE_BUILD_TYPE=Release
	dh_auto_configure --buildsystem=nginx_mod \
		--sourcedirectory=packaging/nginx-module \
		--builddirectory=debian/nginx-module-build

override_dh_auto_build:
	dh_auto_build --buildsystem=cmake --builddirectory=debian/build
	dh_auto_build --buildsystem=nginx_mod \
		--sourcedirectory=packaging/nginx-module \
		--builddirectory=debian/nginx-module-build
	APACHE_BUILD_DIR=$(CURDIR)/debian/apache-module \
		scripts/build-apache-module

override_dh_auto_test:
	nginx -V
	apache2ctl -V

override_dh_auto_clean:
	dh_auto_clean --buildsystem=cmake --builddirectory=debian/build
	dh_auto_clean --buildsystem=nginx_mod \
		--sourcedirectory=packaging/nginx-module \
		--builddirectory=debian/nginx-module-build
	rm -rf debian/apache-module

override_dh_auto_install:
	install -D -m 0755 debian/build/servers/laghu/laghu \
		debian/laghu/usr/bin/laghu
	install -D -m 0644 \
		debian/nginx-module-build/ngx_http_laghu_module.so \
		debian/ngx-laghu/usr/lib/nginx/modules/ngx_http_laghu_module.so
	install -D -m 0644 packaging/nginx/mod-http-laghu.conf \
		debian/ngx-laghu/etc/nginx/modules-available/50-mod-http-laghu.conf
	install -D -m 0755 \
		debian/build/workers/laghu-libvips/laghu-libvips \
		debian/laghu-libvips/usr/bin/laghu-libvips
	install -D -m 0755 \
		debian/build/workers/laghu-resource-fetch/laghu-resource-fetch \
		debian/laghu-libvips/usr/bin/laghu-resource-fetch
	install -D -m 0755 \
		debian/build/workers/laghu-html-refresh/laghu-html-refresh \
		debian/laghu-libvips/usr/bin/laghu-html-refresh
	install -D -m 0755 \
		debian/build/workers/laghu-asset-upload/laghu-asset-upload \
		debian/laghu-libvips/usr/bin/laghu-asset-upload
	install -D -m 0755 \
		debian/build/workers/laghu-js-optimize/cargo/release/laghu-js-optimize \
		debian/laghu-libvips/usr/bin/laghu-js-optimize
	install -D -m 0755 \
		debian/build/workers/laghu-chrome-analyze/laghu-chrome-analyze \
		debian/laghu-libvips/usr/bin/laghu-chrome-analyze
	install -D -m 0644 packaging/systemd/laghu-libvips.service \
		debian/laghu-libvips/lib/systemd/system/laghu-libvips.service
	install -D -m 0644 packaging/systemd/laghu-resource-fetch.service \
		debian/laghu-libvips/lib/systemd/system/laghu-resource-fetch.service
	install -D -m 0644 packaging/systemd/laghu-html-refresh@.service \
		debian/laghu-libvips/lib/systemd/system/laghu-html-refresh@.service
	install -D -m 0644 packaging/systemd/laghu-asset-upload.service \
		debian/laghu-libvips/lib/systemd/system/laghu-asset-upload.service
	install -D -m 0644 packaging/systemd/laghu-js-optimize.service \
		debian/laghu-libvips/lib/systemd/system/laghu-js-optimize.service
	install -D -m 0644 packaging/systemd/laghu-chrome-analyze.service \
		debian/laghu-libvips/lib/systemd/system/laghu-chrome-analyze.service
	install -D -m 0644 packaging/font-providers.conf \
		debian/laghu-libvips/etc/laghu/font-providers.conf
	install -D -m 0644 packaging/html-refresh.conf.example \
		debian/laghu-libvips/usr/share/doc/laghu-libvips/html-refresh.conf.example
	install -D -m 0644 packaging/chrome-analysis.conf.example \
		debian/laghu-libvips/usr/share/doc/laghu-libvips/chrome-analysis.conf.example
	install -D -m 0644 packaging/javascript-observation.conf \
		debian/laghu-libvips/etc/laghu/javascript-observation.conf
	install -D -m 0644 packaging/javascript-defer.conf \
		debian/laghu-libvips/etc/laghu/javascript-defer.conf
	install -D -m 0644 packaging/tmpfiles/laghu.conf \
		debian/laghu-libvips/usr/lib/tmpfiles.d/laghu.conf
	install -D -m 0644 packaging/NOTICE-libvips.md \
		debian/laghu-libvips/usr/share/doc/laghu-libvips/NOTICE-libvips.md
	install -D -m 0644 LICENSE \
		debian/laghu-libvips/usr/share/doc/laghu-libvips/LICENSE
	install -D -m 0644 packaging/nginx/laghu.conf \
		debian/ngx-laghu/etc/nginx/conf.d/laghu.conf
	install -D -m 0644 debian/apache-module/.libs/mod_laghu.so \
		debian/mod-laghu/usr/lib/apache2/modules/mod_laghu.so
	install -D -m 0644 packaging/apache/laghu.load \
		debian/mod-laghu/etc/apache2/mods-available/laghu.load
	install -D -m 0644 packaging/apache/laghu.conf \
		debian/mod-laghu/etc/apache2/mods-available/laghu.conf

override_dh_gencontrol:
	nginx_abi=$$(dpkg-query -W -f='$${Provides}' nginx | tr ',' '\n' | \
		sed -n 's/^ *\(nginx-abi-[^ ]*\) *$$/\1/p' | head -n 1); \
	apache_api=$$(dpkg-query -W -f='$${Provides}' apache2-bin | tr ',' '\n' | \
		sed -n 's/^ *\(apache2-api-[0-9]*\) *$$/\1/p' | head -n 1); \
	test -n "$$nginx_abi"; \
	test -n "$$apache_api"; \
	dh_gencontrol -- -Vlaghu:nginx-abi="$$nginx_abi" \
		-Vlaghu:apache-api="$$apache_api"
