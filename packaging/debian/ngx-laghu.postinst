set -e

if [ "$1" = configure ]; then
  mkdir -p /etc/nginx/modules-enabled
  ln -sfn /etc/nginx/modules-available/50-mod-http-laghu.conf \
    /etc/nginx/modules-enabled/50-mod-http-laghu.conf
  nginx -t
fi

#DEBHELPER#
