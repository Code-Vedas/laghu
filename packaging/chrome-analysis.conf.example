# These values must match the enabled Laghu ChromeAnalysisQueue setting.
LAGHU_CHROME_ANALYSIS_QUEUE=/run/laghu/chrome-analysis.queue
LAGHU_CHROME_ANALYSIS_OUTPUT=/var/cache/laghu/chrome-analysis

# Set this to the executable provided by the distribution or local policy.
LAGHU_CHROME_ANALYSIS_BROWSER=/usr/bin/chromium
