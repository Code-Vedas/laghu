set -eu

QUEUE_PATH=${LAGHU_WORKER_QUEUE:-/run/laghu/jobs.queue}
FONT_QUEUE_PATH=${LAGHU_FONT_FETCH_QUEUE:-/run/laghu/fonts.queue}
FONT_CACHE_PATH=${LAGHU_FONT_CACHE:-/var/cache/laghu/images}
FONT_PROVIDER_CONFIG=${LAGHU_FONT_PROVIDER_CONFIG:-/etc/laghu/font-providers.conf}
CACHE_PATH=${LAGHU_IMAGE_CACHE:-/var/cache/laghu/images}
HTML_REFRESH_QUEUE_PATH=${LAGHU_HTML_REFRESH_QUEUE:-/run/laghu/html-refresh.queue}
HTML_CACHE_ORIGIN=${LAGHU_HTML_CACHE_ORIGIN:-}
OPTIMIZER_PID=""
FONT_FETCH_PID=""
JAVASCRIPT_PID=""
HTML_REFRESH_PID=""
ASSET_PID=""
NGINX_PID=""

terminate() {
  [ "${NGINX_PID}" = "" ] || kill -TERM "${NGINX_PID}" 2>/dev/null || true
  [ "${HTML_REFRESH_PID}" = "" ] || kill -TERM "${HTML_REFRESH_PID}" 2>/dev/null || true
  [ "${JAVASCRIPT_PID}" = "" ] || kill -TERM "${JAVASCRIPT_PID}" 2>/dev/null || true
  [ "${FONT_FETCH_PID}" = "" ] || kill -TERM "${FONT_FETCH_PID}" 2>/dev/null || true
  [ "${ASSET_PID}" = "" ] || kill -TERM "${ASSET_PID}" 2>/dev/null || true
  [ "${OPTIMIZER_PID}" = "" ] || kill -TERM "${OPTIMIZER_PID}" 2>/dev/null || true
}
trap terminate EXIT HUP INT QUIT TERM

laghu-libvips --init "${QUEUE_PATH}" "${CACHE_PATH}"
laghu-libvips --serve "${QUEUE_PATH}" "${CACHE_PATH}" &
OPTIMIZER_PID=$!
laghu-resource-fetch --init "${FONT_QUEUE_PATH}" "${FONT_CACHE_PATH}" "${FONT_PROVIDER_CONFIG}"
laghu-resource-fetch --serve "${FONT_QUEUE_PATH}" "${FONT_CACHE_PATH}" "${FONT_PROVIDER_CONFIG}" &
FONT_FETCH_PID=$!
laghu-js-optimize --init /run/laghu/javascript.queue "${CACHE_PATH}"
laghu-js-optimize --serve /run/laghu/javascript.queue "${CACHE_PATH}" &
JAVASCRIPT_PID=$!
if [ -n "${HTML_CACHE_ORIGIN}" ]; then
  laghu-html-refresh --init "${HTML_REFRESH_QUEUE_PATH}" "${CACHE_PATH}" "${HTML_CACHE_ORIGIN}"
  laghu-html-refresh --serve "${HTML_REFRESH_QUEUE_PATH}" "${CACHE_PATH}" "${HTML_CACHE_ORIGIN}" &
  HTML_REFRESH_PID=$!
fi
if [ -f /etc/laghu/asset-offload.conf ]; then
  laghu-asset-upload --serve /etc/laghu/asset-offload.conf &
  ASSET_PID=$!
fi
nginx -g 'daemon off;' &
NGINX_PID=$!

while kill -0 "${OPTIMIZER_PID}" 2>/dev/null &&
      kill -0 "${FONT_FETCH_PID}" 2>/dev/null &&
      kill -0 "${JAVASCRIPT_PID}" 2>/dev/null &&
      { [ "${HTML_REFRESH_PID}" = "" ] || kill -0 "${HTML_REFRESH_PID}" 2>/dev/null; } &&
      { [ "${ASSET_PID}" = "" ] || kill -0 "${ASSET_PID}" 2>/dev/null; } &&
      kill -0 "${NGINX_PID}" 2>/dev/null; do
  sleep 1
done

status=0
if ! kill -0 "${NGINX_PID}" 2>/dev/null; then
  wait "${NGINX_PID}" || status=$?
elif ! kill -0 "${OPTIMIZER_PID}" 2>/dev/null; then
  wait "${OPTIMIZER_PID}" || status=$?
elif ! kill -0 "${FONT_FETCH_PID}" 2>/dev/null; then
  wait "${FONT_FETCH_PID}" || status=$?
elif ! kill -0 "${JAVASCRIPT_PID}" 2>/dev/null; then
  wait "${JAVASCRIPT_PID}" || status=$?
elif [ "${HTML_REFRESH_PID}" != "" ] && ! kill -0 "${HTML_REFRESH_PID}" 2>/dev/null; then
  wait "${HTML_REFRESH_PID}" || status=$?
elif [ "${ASSET_PID}" != "" ] && ! kill -0 "${ASSET_PID}" 2>/dev/null; then
  wait "${ASSET_PID}" || status=$?
fi
exit "${status}"
