set -eu

queue=${LAGHU_QUEUE_PATH:-/run/laghu/jobs.queue}
cache=${LAGHU_CACHE_PATH:-/var/cache/laghu/images}
font_queue=${LAGHU_FONT_FETCH_QUEUE:-/run/laghu/fonts.queue}
font_config=${LAGHU_FONT_PROVIDER_CONFIG:-/etc/laghu/font-providers.conf}
html_refresh_queue=${LAGHU_HTML_REFRESH_QUEUE:-/run/laghu/html-refresh.queue}
html_cache_origin=${LAGHU_HTML_CACHE_ORIGIN:-}
chrome_analysis_queue=${LAGHU_CHROME_ANALYSIS_QUEUE:-}
chrome_analysis_output=${LAGHU_CHROME_ANALYSIS_OUTPUT:-/var/cache/laghu/chrome-analysis}
chrome_analysis_browser=${LAGHU_CHROME_ANALYSIS_BROWSER:-chromium}

runuser -u laghu -- laghu-libvips --init "${queue}" "${cache}"
chmod 0660 "${queue}"
runuser -u laghu -- laghu-libvips --serve "${queue}" "${cache}" &
service_pid=$!
runuser -u laghu -- laghu-resource-fetch --init "${font_queue}" "${cache}" "${font_config}"
chmod 0660 "${font_queue}"
runuser -u laghu -- laghu-resource-fetch --serve "${font_queue}" "${cache}" "${font_config}" &
font_fetch_pid=$!
runuser -u laghu -- laghu-js-optimize --init /run/laghu/javascript.queue "${cache}"
chmod 0660 /run/laghu/javascript.queue
runuser -u laghu -- laghu-js-optimize --serve /run/laghu/javascript.queue "${cache}" &
javascript_pid=$!
html_refresh_pid=""
if [ -n "${html_cache_origin}" ]; then
  runuser -u laghu -- laghu-html-refresh --init "${html_refresh_queue}" "${cache}" "${html_cache_origin}"
  chmod 0660 "${html_refresh_queue}"
  runuser -u laghu -- laghu-html-refresh --serve "${html_refresh_queue}" "${cache}" "${html_cache_origin}" &
  html_refresh_pid=$!
fi
asset_pid=""
if [ -f /etc/laghu/asset-offload.conf ]; then
  runuser -u laghu -- laghu-asset-upload --serve /etc/laghu/asset-offload.conf &
  asset_pid=$!
fi
chrome_analysis_pid=""
if [ -n "${chrome_analysis_queue}" ]; then
  if ! command -v "${chrome_analysis_browser}" >/dev/null 2>&1; then
    echo "LAGHU_CHROME_ANALYSIS_QUEUE is set, but ${chrome_analysis_browser} is not executable." >&2
    exit 1
  fi
  mkdir -p "${chrome_analysis_output}"
  chown laghu:laghu "${chrome_analysis_output}"
  runuser -u laghu -- laghu-chrome-analyze --init "${chrome_analysis_queue}" "${chrome_analysis_output}" "${chrome_analysis_browser}"
  chmod 0660 "${chrome_analysis_queue}"
  runuser -u laghu -- laghu-chrome-analyze --serve "${chrome_analysis_queue}" "${chrome_analysis_output}" "${chrome_analysis_browser}" &
  chrome_analysis_pid=$!
fi

cleanup() {
  kill "${service_pid}" 2>/dev/null || true
  kill "${font_fetch_pid}" 2>/dev/null || true
  kill "${javascript_pid}" 2>/dev/null || true
  [ "${html_refresh_pid}" = "" ] || kill "${html_refresh_pid}" 2>/dev/null || true
  [ "${asset_pid}" = "" ] || kill "${asset_pid}" 2>/dev/null || true
  [ "${chrome_analysis_pid}" = "" ] || kill "${chrome_analysis_pid}" 2>/dev/null || true
  wait "${service_pid}" 2>/dev/null || true
  wait "${font_fetch_pid}" 2>/dev/null || true
  wait "${javascript_pid}" 2>/dev/null || true
  [ "${html_refresh_pid}" = "" ] || wait "${html_refresh_pid}" 2>/dev/null || true
  [ "${asset_pid}" = "" ] || wait "${asset_pid}" 2>/dev/null || true
  [ "${chrome_analysis_pid}" = "" ] || wait "${chrome_analysis_pid}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

exec apache2ctl -D FOREGROUND
