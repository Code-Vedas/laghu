FROM ubuntu:24.04 AS build

ARG LAGHU_BUILD_REVISION=0.1.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      apache2-dev build-essential ca-certificates cmake libvips-dev pkgconf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
COPY --from=rust:1.95-bookworm /usr/local/cargo /usr/local/cargo
COPY --from=rust:1.95-bookworm /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:${PATH} RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN cmake -S . -B build -DLAGHU_WITH_VIPS=ON -DLAGHU_BUILD_TESTS=OFF \
      -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target laghu-libvips laghu-resource-fetch laghu-html-refresh laghu-asset-upload laghu-js-optimize laghu-chrome-analyze --parallel \
    && APACHE_BUILD_DIR=/src/apache-module scripts/build-apache-module

FROM ubuntu:24.04

ARG LAGHU_BUILD_REVISION=0.1.0
ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="mod-laghu" \
      org.opencontainers.image.description="Apache HTTP Server with the native mod_laghu adapter" \
      org.opencontainers.image.url="https://laghu.codevedas.com" \
      org.opencontainers.image.source="https://github.com/Code-Vedas/laghu" \
      org.opencontainers.image.version="${LAGHU_BUILD_REVISION}" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && apt-get install --no-install-recommends -y apache2 ffmpeg libheif-plugin-aomenc libjxl0.7 libvips42 tini util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system laghu \
    && useradd --system --gid laghu --home-dir /nonexistent --shell /usr/sbin/nologin laghu \
    && usermod -a -G laghu www-data \
    && mkdir -p /run/laghu /var/cache/laghu/images /var/lib/laghu/rum \
    && chown -R laghu:laghu /run/laghu /var/cache/laghu /var/lib/laghu \
    && chmod 0770 /var/lib/laghu/rum

COPY --from=build /src/build/workers/laghu-libvips/laghu-libvips /usr/bin/laghu-libvips
COPY --from=build /src/build/workers/laghu-resource-fetch/laghu-resource-fetch /usr/bin/laghu-resource-fetch
COPY --from=build /src/build/workers/laghu-html-refresh/laghu-html-refresh /usr/bin/laghu-html-refresh
COPY --from=build /src/build/workers/laghu-asset-upload/laghu-asset-upload /usr/bin/laghu-asset-upload
COPY --from=build /src/build/workers/laghu-js-optimize/cargo/release/laghu-js-optimize /usr/bin/laghu-js-optimize
COPY --from=build /src/build/workers/laghu-chrome-analyze/laghu-chrome-analyze /usr/bin/laghu-chrome-analyze
COPY --from=build /src/apache-module/.libs/mod_laghu.so /usr/lib/apache2/modules/mod_laghu.so
COPY packaging/font-providers.conf /etc/laghu/font-providers.conf
COPY packaging/javascript-observation.conf /etc/laghu/javascript-observation.conf
COPY packaging/javascript-defer.conf /etc/laghu/javascript-defer.conf
COPY packaging/apache/laghu.load /etc/apache2/mods-available/laghu.load
COPY packaging/apache/laghu.conf /etc/apache2/mods-available/laghu.conf
COPY packaging/container/entrypoint.apache /usr/bin/mod-laghu-entrypoint

RUN a2enmod headers laghu \
    && chmod 0755 /usr/bin/mod-laghu-entrypoint \
    && apache2ctl configtest

EXPOSE 80
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/bin/mod-laghu-entrypoint"]
