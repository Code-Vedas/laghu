# LICENSE file in the root directory of this source tree.

set -eu

rpm_chrome_analysis_supported=1
chrome_focused_tests=OFF

chrome_runtime() {
  for candidate in \
    /usr/lib/chromium/chromium \
    /usr/lib/chromium-browser/chromium \
    /usr/lib/chromium-browser/chromium-browser \
    /usr/lib64/chromium/chromium \
    /usr/lib64/chromium/chromium-browser \
    /usr/lib64/chromium-browser/chromium \
    /usr/lib64/chromium-browser/chromium-browser; do
    if [ -x "${candidate}" ] &&
        [ "$(dd if="${candidate}" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \\n')" = 7f454c46 ]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done

  for command_name in chromium chromium-browser google-chrome google-chrome-stable; do
    candidate=$(command -v "${command_name}" 2>/dev/null || true)
    if [ -n "${candidate}" ] && [ -x "${candidate}" ] &&
        [ "$(dd if="${candidate}" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \\n')" = 7f454c46 ]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done

  echo "No Chromium ELF runtime found (refusing command-wrapper path)" >&2
  return 1
}

if [ "${LAGHU_WITH_CHROME:-OFF}" = ON ]; then
  command -v bwrap >/dev/null 2>&1
  bwrap --version
  chrome_binary=$(chrome_runtime)
  "${chrome_binary}" --version
fi

if [ "${LAGHU_CHROME_FOCUSED_TESTS:-OFF}" = ON ] || \
   { [ "${LAGHU_PACKAGE_PROOF_ONLY:-OFF}" = ON ] && [ "${LAGHU_WITH_CHROME:-OFF}" = ON ]; }; then
  chrome_focused_tests=ON
fi

if command -v bsdtar >/dev/null 2>&1; then
  export TAR=bsdtar
fi

# Docker dependency layers can outlive an RPM repository publication. Refresh
# the matched server and development packages before compiling so the generated
# ABI requirement is installable from the same repository snapshot used by the
# clean-host package test below.
case "${PACKAGE_FAMILY}" in
  dnf|yum)
    if [ "${SERVER}" = nginx ]; then
      "${PACKAGE_FAMILY}" upgrade -y nginx nginx-core nginx-mod-devel
    else
      "${PACKAGE_FAMILY}" upgrade -y httpd httpd-core httpd-devel
    fi
    ;;
esac

scripts/run-build-all
if [ "${LAGHU_WITH_CHROME:-OFF}" = ON ]; then
  chrome_worker="${BUILD_DIR:-${PWD}/tmp/build}/workers/laghu-chrome-analyze/laghu-chrome-analyze"
  root_probe=$(mktemp -d)
  if "${chrome_worker}" --init "${root_probe}/analysis.queue" "${root_probe}"; then
    echo "laghu-chrome-analyze unexpectedly accepted root" >&2
    exit 1
  else
    root_status=$?
  fi
  [ "${root_status}" -eq 77 ]
  [ ! -e "${root_probe}/analysis.queue" ]
  rmdir "${root_probe}"
fi
if [ -n "${LAGHU_TEST_USER:-}" ]; then
  [ "$(id -u)" = 0 ]
  id -u "${LAGHU_TEST_USER}" >/dev/null 2>&1
  mkdir -p /workspace/tmp
  chown -R "${LAGHU_TEST_USER}" /workspace/tmp /usr/local/cargo /usr/local/rustup
  test_command=scripts/run-test-all
  if [ "${chrome_focused_tests}" = ON ]; then
    test_command='ctest --test-dir /workspace/tmp/build --output-on-failure -R "^laghu_chrome_analyze_(old_bwrap|startup)_test$"'
    echo "Running focused Chrome CTest as unprivileged ${LAGHU_TEST_USER}; Docker build remains root."
  else
    echo "Running CTest as unprivileged ${LAGHU_TEST_USER}; Docker build remains root."
  fi
  su --login --shell /bin/sh "${LAGHU_TEST_USER}" --command \
    "cd /workspace && CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PYTHONDONTWRITEBYTECODE=1 ${test_command}"
else
  if [ "${chrome_focused_tests}" = ON ]; then
    ctest --test-dir /workspace/tmp/build --output-on-failure -R '^laghu_chrome_analyze_(old_bwrap|startup)_test$'
  else
    scripts/run-test-all
  fi
fi

if [ "${LAGHU_CHROME_FOCUSED_TESTS:-OFF}" = ON ] && [ "${LAGHU_PACKAGE_PROOF_ONLY:-OFF}" != ON ]; then
  echo "Focused Chrome isolation build passed; module and package proof are intentionally skipped."
  exit 0
fi

if [ "${SERVER}" = standalone ]; then
  scripts/run-standalone-container-smoke
  exit 0
fi

if [ "${LAGHU_PACKAGE_PROOF_ONLY:-OFF}" != ON ]; then
  if [ "${SERVER}" = nginx ]; then
    scripts/run-module-build-all
    scripts/run-module-smoke-all
  else
    scripts/run-apache-module-smoke-all
  fi
fi

if [ "${LAGHU_SKIP_PACKAGE:-OFF}" = ON ] || [ "${LAGHU_WITH_VIPS}" = OFF ]; then
  echo "Custom no-libvips build passed; official package construction is intentionally skipped."
  exit 0
fi

case "${PACKAGE_FAMILY}" in
  apt)
    cp -R packaging/debian debian
    dpkg-buildpackage --build=binary --no-sign
    dpkg-deb -f ../laghu-libvips_*.deb Depends | grep -F 'bubblewrap (>= 0.8.0)'
    # Container dependency layers may outlive a mirror publication. Refresh
    # immediately before the clean-host install so package versions referenced
    # by APT still exist on the configured mirror.
    apt-get update
    # Build/test dependencies can already provide Bubblewrap.  Remove it
    # before the clean-host install so APT must satisfy the package's declared
    # versioned runtime dependency rather than inheriting it from the builder.
    if dpkg-query -W -f='${db:Status-Status}' bubblewrap 2>/dev/null | grep -qx installed; then
      apt-get purge -y bubblewrap
    fi
    # `dash` may retain a command lookup after `apt-get purge`; package state,
    # rather than a shell cache, proves the clean-host precondition.
    if dpkg-query -W -f='${db:Status-Status}' bubblewrap 2>/dev/null | grep -qx installed; then
      echo "Bubblewrap package remained installed before the clean-host package install" >&2
      exit 1
    fi
    if [ "${SERVER}" = nginx ]; then
      dependencies=$(dpkg-deb -f ../ngx-laghu_*.deb Depends)
      printf '%s\n' "${dependencies}" | grep -q 'nginx-abi-'
      printf '%s\n' "${dependencies}" | grep -q 'laghu-libvips'
      installed=$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null |
        sed 's/:.*//' | grep -E '^(nginx|nginx-(common|core|dev|full|light))$' || true)
      if [ -n "${installed}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${installed}
      fi
      if command -v nginx >/dev/null 2>&1; then
        echo "NGINX remained installed before the clean-host package install" >&2
        exit 1
      fi
      apt-get install -y ../laghu-libvips_*.deb ../ngx-laghu_*.deb
      nginx -t
    else
      dependencies=$(dpkg-deb -f ../mod-laghu_*.deb Depends)
      printf '%s\n' "${dependencies}" | grep -q 'apache2-api-'
      printf '%s\n' "${dependencies}" | grep -q 'laghu-libvips'
      installed=$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null |
        sed 's/:.*//' | grep -E '^apache2($|-bin$|-data$|-dev$|-utils$)' || true)
      if [ -n "${installed}" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y ${installed}
      fi
      if command -v apache2 >/dev/null 2>&1; then
        echo "Apache remained installed before the clean-host package install" >&2
        exit 1
      fi
      apt-get install -y ../laghu-libvips_*.deb ../mod-laghu_*.deb
      apache2ctl configtest
    fi
    ;;
  dnf|yum)
    mkdir -p "$HOME/rpmbuild/SOURCES" "$HOME/rpmbuild/SPECS"
    version=$(awk '/^Version:/ { print $2; exit }' packaging/rpm/laghu.spec)
    staging=$(mktemp -d)
    mkdir -p "${staging}/laghu-${version}"
    find . -mindepth 1 -maxdepth 1 ! -name .git ! -name tmp \
      -exec cp -a '{}' "${staging}/laghu-${version}/" ';'
    "${TAR:-tar}" -C "${staging}" -czf \
      "$HOME/rpmbuild/SOURCES/laghu-${version}.tar.gz" "laghu-${version}"
    rm -rf "${staging}"
    cp packaging/rpm/laghu.spec "$HOME/rpmbuild/SPECS/laghu.spec"
    rpmbuild -ba "$HOME/rpmbuild/SPECS/laghu.spec"
    if [ "$(rpm --eval '%{?rhel}')" = 9 ]; then
      rpm_chrome_analysis_supported=0
      chrome_requires=$(rpm -qp --requires "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm)
      chrome_files=$(rpm -qlp "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm)
      if printf '%s\n' "${chrome_requires}" | grep -q '^bubblewrap >= 0.8.0$'; then
        echo "EL9 package unexpectedly requires Bubblewrap >= 0.8.0" >&2
        exit 1
      fi
      if printf '%s\n' "${chrome_files}" | grep -q '/laghu-chrome-analyze'; then
        echo "EL9 package unexpectedly ships laghu-chrome-analyze" >&2
        exit 1
      fi
      if printf '%s\n' "${chrome_files}" | grep -q '/chrome-analysis.conf.example'; then
        echo "EL9 package unexpectedly ships the Chrome analysis example" >&2
        exit 1
      fi
    else
      rpm -qp --requires "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm | grep -q '^bubblewrap >= 0.8.0$'
      rpm -qp --requires "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm | grep -q '^/usr/bin/ffmpeg$'
      rpm -qlp "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm | grep -q '/laghu-chrome-analyze'
      rpm -qlp "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm | grep -q '/chrome-analysis.conf.example'
    fi
    if [ "${SERVER}" = nginx ]; then
      requirements=$(rpm -qp --requires "$HOME"/rpmbuild/RPMS/*/ngx-laghu-*.rpm)
      printf '%s\n' "${requirements}" | grep -q 'nginx(abi)'
      printf '%s\n' "${requirements}" | grep -q 'laghu-libvips'
      "${PACKAGE_FAMILY}" remove -y nginx nginx-mod-devel
      if command -v nginx >/dev/null 2>&1; then
        echo "NGINX remained installed before the clean-host RPM install" >&2
        exit 1
      fi
      if rpm -q bubblewrap >/dev/null 2>&1; then
        "${PACKAGE_FAMILY}" remove -y bubblewrap
      fi
      if rpm -q bubblewrap >/dev/null 2>&1; then
        echo "Bubblewrap remained installed before the clean-host RPM install" >&2
        exit 1
      fi
      chrome_package=
      if [ "${LAGHU_WITH_CHROME:-OFF}" = ON ]; then
        chrome_package=chromium
        if rpm -q "${chrome_package}" >/dev/null 2>&1; then
          "${PACKAGE_FAMILY}" remove -y "${chrome_package}"
        fi
        if rpm -q "${chrome_package}" >/dev/null 2>&1; then
          echo "Chromium remained installed before the clean-host RPM install" >&2
          exit 1
        fi
      fi
      if [ -n "${chrome_package}" ]; then
        "${PACKAGE_FAMILY}" install -y "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm \
          "$HOME"/rpmbuild/RPMS/*/ngx-laghu-*.rpm "${chrome_package}"
      else
        "${PACKAGE_FAMILY}" install -y "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm \
          "$HOME"/rpmbuild/RPMS/*/ngx-laghu-*.rpm
      fi
      nginx -t
    else
      requirements=$(rpm -qp --requires "$HOME"/rpmbuild/RPMS/*/mod-laghu-*.rpm)
      printf '%s\n' "${requirements}" | grep -q 'httpd-mmn'
      printf '%s\n' "${requirements}" | grep -q 'laghu-libvips'
      "${PACKAGE_FAMILY}" remove -y httpd httpd-core httpd-devel
      if command -v httpd >/dev/null 2>&1; then
        echo "Apache remained installed before the clean-host RPM install" >&2
        exit 1
      fi
      "${PACKAGE_FAMILY}" install -y "$HOME"/rpmbuild/RPMS/*/laghu-libvips-*.rpm \
        "$HOME"/rpmbuild/RPMS/*/mod-laghu-*.rpm
      httpd -t
    fi
    ;;
esac

if [ "${SERVER}" = nginx ]; then
  installed_config=/etc/nginx/conf.d/laghu.conf
  grep -q '^laghu rum_store local:;' "${installed_config}"
  grep -q '^laghu rum_store_local_snapshot /var/lib/laghu/rum/rum.snapshot;' \
    "${installed_config}"
else
  installed_config=/etc/apache2/mods-available/laghu.conf
  [ -f "${installed_config}" ] || installed_config=/etc/httpd/conf.d/laghu.conf
  grep -q '^Laghu RumStore local:$' "${installed_config}"
  grep -q '^Laghu RumStoreLocalSnapshot /var/lib/laghu/rum/rum.snapshot$' \
    "${installed_config}"
fi
test -d /var/lib/laghu/rum
if [ "${rpm_chrome_analysis_supported}" = 0 ]; then
  [ ! -e /usr/bin/laghu-chrome-analyze ]
  [ ! -e /usr/lib/systemd/system/laghu-chrome-analyze.service ]
  [ ! -e /usr/share/doc/laghu/chrome-analysis.conf.example ]
else
  test -x /usr/bin/laghu-chrome-analyze
  case "${PACKAGE_FAMILY}" in
    apt)
      dpkg-query -W -f='${db:Status-Status}' bubblewrap | grep -qx installed
      dpkg-query -S /usr/bin/laghu-chrome-analyze | grep -q '^laghu-libvips:'
      ;;
    dnf|yum)
      rpm -q bubblewrap >/dev/null
      rpm -q --whatprovides /usr/bin/bwrap >/dev/null
      rpm -q --whatprovides /usr/bin/ffmpeg >/dev/null
      rpm -qf /usr/bin/laghu-chrome-analyze 2>/dev/null | grep -q '^laghu-libvips-'
      ;;
  esac
  id -u laghu >/dev/null
  test -x /usr/bin/bwrap
  test -x /usr/bin/ffmpeg
  chrome_unit=/lib/systemd/system/laghu-chrome-analyze.service
  [ -f "${chrome_unit}" ] || chrome_unit=/usr/lib/systemd/system/laghu-chrome-analyze.service
  grep -q '^EnvironmentFile=/etc/laghu/chrome-analysis.conf$' "${chrome_unit}"
  grep -q 'LAGHU_CHROME_ANALYSIS_QUEUE' "${chrome_unit}"
  grep -q 'LAGHU_CHROME_ANALYSIS_OUTPUT' "${chrome_unit}"
  grep -q 'LAGHU_CHROME_ANALYSIS_BROWSER' "${chrome_unit}"
  grep -q '^PrivateNetwork=true$' "${chrome_unit}"
  grep -q '^RestrictAddressFamilies=AF_UNIX AF_NETLINK$' "${chrome_unit}"
  systemd-analyze verify "${chrome_unit}"
fi
