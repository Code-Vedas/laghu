# One systemd instance owns one administrator-configured HTTPS origin and its
# matching adapter queue. Copy to /etc/laghu/html-refresh/NAME.conf, replace
# the placeholder, then enable laghu-html-refresh@NAME.
LAGHU_HTML_REFRESH_QUEUE=/run/laghu/html-refresh-www.queue
LAGHU_HTML_REFRESH_CACHE=/var/cache/laghu/images
LAGHU_HTML_REFRESH_ORIGIN=https://origin.example.com
