# Strict standalone configuration. Files in conf.d/*.yaml are read in
# lexical order after this file. Keep the service account as the owner and do
# not make configuration group- or world-writable.
runtime:
  listen: 0.0.0.0:8080
  origin: http://127.0.0.1:8000
  file_cache_backend: file:///var/cache/laghu/images
  worker_queue: /run/laghu/jobs.queue
  pid_file: /run/laghu/laghu.pid
  preset: balanced
  workers: 4
  connection_queue: 64
  connect_timeout: 5
  io_timeout: 30
  # Idle I/O remains 30 seconds; these total limits do not reset per byte.
  request_header_timeout: 10
  request_body_timeout: 60
  drain_timeout: 30

# Ordered routes run before static or the global origin. Exactly one of
# redirect or proxy_pass is required for each route. proxy_pass accepts
# http://, https://, fastcgi://, uwsgi://, and scgi:// targets.
routes:
  - match: prefix
    pattern: /api/
    proxy_pass: https://api.internal.example:8443
    health_check: /healthz
    health_interval: 5
    failover:
      - https://api-backup.internal.example:8443
  - match: prefix
    pattern: /php/
    proxy_pass: fastcgi://127.0.0.1:9000

# Site policy and service settings inherit from runtime, then a nested route
# may narrow them further. Add paired tls_certificate/tls_private_key paths to
# a site to terminate a matching SNI hostname.
sites:
  - host: shop.example.test
    document_root: /srv/laghu/shop
    laghu:
      preset: safe
      # Static responses, including ranges and directory listings, pass through
      # the Laghu transaction contract before delivery. gzip applies only to
      # eligible full responses from clients that advertise it.
      compression: gzip
      spa_fallback: /index.html
      request_header_limit: 32k
      request_body_limit: 1m
      static_max_bytes: 16m
      allow:
        - 10.0.0.0/8
      # Use scrypt-v1 records. Basic credentials require direct TLS, or a
      # trusted TLS terminator with respect_x_forwarded_proto enabled.
      basic_auth_file: /etc/laghu/shop.basic-auth
      basic_auth_realm: Shop administration
      rate_limit: 20
      rate_burst: 40
    service:
      javascript_target: defaults
    routes:
      - match: exact
        pattern: /legacy
        redirect: /modern
        laghu:
          mode: off
