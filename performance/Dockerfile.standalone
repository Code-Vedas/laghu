FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      build-essential ca-certificates cmake libssl-dev libvips-dev pkgconf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
COPY --from=rust:1.95-bookworm /usr/local/cargo /usr/local/cargo
COPY --from=rust:1.95-bookworm /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:${PATH} RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo

RUN cmake -S . -B build -DLAGHU_WITH_VIPS=ON -DLAGHU_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target laghu laghu-libvips laghu-js-optimize --parallel

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y libheif-plugin-aomenc libjxl0.7 libssl3t64 libvips42t64 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system laghu \
    && useradd --system --gid laghu laghu \
    && install -d -o laghu -g laghu -m 0750 /run/laghu /var/cache/laghu/images \
    && chown -R laghu:laghu /var/cache/laghu

COPY --from=build /src/build/servers/laghu/laghu /usr/bin/laghu
COPY --from=build /src/build/workers/laghu-libvips/laghu-libvips /usr/bin/laghu-libvips
COPY --from=build /src/build/workers/laghu-js-optimize/cargo/release/laghu-js-optimize /usr/bin/laghu-js-optimize
COPY performance/standalone-entrypoint /usr/bin/laghu-benchmark-entrypoint

RUN chmod 0755 /usr/bin/laghu-benchmark-entrypoint

USER laghu
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/bin/laghu-benchmark-entrypoint"]
