set -eu

: "${LAGHU_BENCH_ORIGIN:?LAGHU_BENCH_ORIGIN is required}"
rewrite_level=${LAGHU_BENCH_REWRITE_LEVEL:-all}
queue=/run/laghu/jobs.queue
javascript_queue=/run/laghu/javascript.queue
cache=/var/cache/laghu/images
config=/run/laghu/benchmark.yaml
printf '%s\n' \
  'runtime:' \
  '  listen: 0.0.0.0:8080' \
  "  origin: ${LAGHU_BENCH_ORIGIN}" \
  "  rewrite_level: ${rewrite_level}" \
  "  file_cache_backend: file://${cache}" \
  "  worker_queue: ${queue}" \
  '  workers: 1' \
  '  connection_queue: 4096' \
  '  origin_pool_size: 1024' >"${config}"
laghu-libvips --init "${queue}" "${cache}"
if [ "${rewrite_level}" != passthrough ]; then
  laghu-js-optimize --init "${javascript_queue}" "${cache}"
  printf '%s\n' \
    "  javascript_queue: ${javascript_queue}" >>"${config}"
fi
printf '%s\n' \
  'sites:' \
  '  - host: alpha.bench.test' \
  '    document_root: /srv/corpus' \
  '  - host: beta.bench.test' \
  '    document_root: /srv/corpus' \
  'routes:' \
  '  - match: exact' \
  '    pattern: /redirect' \
  '    redirect: /redirect-target' \
  '  - match: prefix' \
  '    pattern: /proxy/' \
  "    proxy_pass: ${LAGHU_BENCH_ORIGIN}" >>"${config}"
chown laghu:laghu "${config}"
chmod 600 "${config}"
laghu --config "${config}" &
server=$!
sleep 3
kill -0 "${server}"
if [ "${rewrite_level}" != passthrough ]; then
  laghu-libvips --serve "${queue}" "${cache}" &
  vips_worker=$!
  laghu-js-optimize --serve "${javascript_queue}" "${cache}" &
  javascript_worker=$!
fi

cleanup() {
  kill "${server:-}" "${vips_worker:-}" "${javascript_worker:-}" 2>/dev/null || true
  wait "${server:-}" "${vips_worker:-}" "${javascript_worker:-}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait "${server}"
