set -eu

: "${LAGHU_BENCH_ORIGIN:?LAGHU_BENCH_ORIGIN is required}"
rewrite_level=${LAGHU_BENCH_REWRITE_LEVEL:-all}
workers=${LAGHU_BENCH_WORKERS:-1}
passthrough_profile=${LAGHU_BENCH_PASSTHROUGH_PROFILE:-production}
access_log=${LAGHU_BENCH_ACCESS_LOG:-on}
queue=/run/laghu/jobs.queue
javascript_queue=/run/laghu/javascript.queue
cache=/var/cache/laghu/images
config=/run/laghu/benchmark.yaml
case "${workers}" in
  ''|*[!0-9]*|0) echo 'LAGHU_BENCH_WORKERS must be a positive integer.' >&2; exit 64 ;;
esac
case "${passthrough_profile}" in
  production|minimal) ;;
  *) echo 'LAGHU_BENCH_PASSTHROUGH_PROFILE must be production or minimal.' >&2; exit 64 ;;
esac
case "${access_log}" in on|off) ;; *) echo 'LAGHU_BENCH_ACCESS_LOG must be on or off.' >&2; exit 64 ;; esac
printf '%s\n' \
  'runtime:' \
  '  listen: 0.0.0.0:8080' \
  "  origin: ${LAGHU_BENCH_ORIGIN}" \
  "  rewrite_level: ${rewrite_level}" \
  "  access_log: ${access_log}" \
  "  workers: ${workers}" \
  '  connection_queue: 4096' \
  '  origin_pool_size: 1024' >"${config}"
if [ "${rewrite_level}" != passthrough ]; then
  printf '%s\n' \
    "  file_cache_backend: file://${cache}" \
    "  worker_queue: ${queue}" >>"${config}"
  laghu-libvips --init "${queue}" "${cache}"
  laghu-js-optimize --init "${javascript_queue}" "${cache}"
  printf '%s\n' \
    "  javascript_queue: ${javascript_queue}" >>"${config}"
fi
printf '%s\n' \
  'sites:' \
  '  - host: alpha.bench.test' \
  '    document_root: /srv/corpus' \
  '  - host: beta.bench.test' \
  '    document_root: /srv/corpus' \
  'routes:' \
  '  - match: exact' \
  '    pattern: /redirect' \
  '    redirect: /redirect-target' \
  '  - match: prefix' \
  '    pattern: /proxy/' \
  "    proxy_pass: ${LAGHU_BENCH_ORIGIN}" >>"${config}"
chown laghu:laghu "${config}"
chmod 600 "${config}"
# Native standalone currently emits access records and diagnostics through the
# same stderr stream. Keep it intact: the rail records logging equivalence as
# unavailable instead of suppressing startup/runtime evidence.
laghu --config "${config}" &
server=$!
sleep 3
kill -0 "${server}"
if [ "${rewrite_level}" != passthrough ]; then
  laghu-libvips --serve "${queue}" "${cache}" &
  vips_worker=$!
  laghu-js-optimize --serve "${javascript_queue}" "${cache}" &
  javascript_worker=$!
fi

cleanup() {
  kill "${server:-}" "${vips_worker:-}" "${javascript_worker:-}" 2>/dev/null || true
  wait "${server:-}" "${vips_worker:-}" "${javascript_worker:-}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait "${server}"
