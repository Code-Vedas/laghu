ngx_addon_name=ngx_http_laghu_module

LAGHU_CORE_DIR="$ngx_addon_dir/../../libs/laghu-core"
LAGHU_BASE_DIR="$ngx_addon_dir/../../libs/laghu-base"
LAGHU_MARKUP_DIR="$ngx_addon_dir/../../libs/laghu-markup"
LAGHU_RUNTIME_DIR="$ngx_addon_dir/../../libs/laghu-runtime"
LAGHU_IMAGE_DIR="$ngx_addon_dir/../../libs/laghu-image"
LAGHU_HTTP_DIR="$ngx_addon_dir/../../libs/laghu-http"
case "${NGX_PLATFORM:-}" in
    win32)
        LAGHU_RUNTIME_PLATFORM="$LAGHU_RUNTIME_DIR/src/runtime_win32.c"
        LAGHU_MODULE_CFLAGS="-DLAGHU_HAVE_VIPS=0 /FIngx_config.h"
        ;;
    *)
        LAGHU_RUNTIME_PLATFORM="$LAGHU_RUNTIME_DIR/src/runtime_posix.c"
        LAGHU_MODULE_CFLAGS="-DLAGHU_HAVE_VIPS=0"
        ;;
esac

LAGHU_MODULE_SRCS="$ngx_addon_dir/ngx_http_laghu_module.c $LAGHU_RUNTIME_PLATFORM"
for laghu_source in $(awk -F'|' '$1 ~ /^(base|markup|core|image|runtime|http)$/ { gsub(/\r/, "", $3); print $3 }' "$ngx_addon_dir/../../cmake/laghu-sources.list"); do
    LAGHU_MODULE_SRCS="$LAGHU_MODULE_SRCS $ngx_addon_dir/../../$laghu_source"
done

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP_AUX_FILTER
    ngx_module_name=ngx_http_laghu_module
    ngx_module_incs="$LAGHU_BASE_DIR/include $LAGHU_MARKUP_DIR/include $LAGHU_CORE_DIR/include $LAGHU_HTTP_DIR/include $LAGHU_RUNTIME_DIR/include $LAGHU_IMAGE_DIR/include"
    ngx_module_srcs="$LAGHU_MODULE_SRCS"
    ngx_module_cflags="$LAGHU_MODULE_CFLAGS"

    . auto/module
else
    HTTP_AUX_FILTER_MODULES="$HTTP_AUX_FILTER_MODULES ngx_http_laghu_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $LAGHU_MODULE_SRCS"
    CFLAGS="$CFLAGS $LAGHU_MODULE_CFLAGS"
    CORE_INCS="$CORE_INCS $LAGHU_BASE_DIR/include $LAGHU_MARKUP_DIR/include $LAGHU_CORE_DIR/include $LAGHU_HTTP_DIR/include $LAGHU_RUNTIME_DIR/include $LAGHU_IMAGE_DIR/include"
fi
