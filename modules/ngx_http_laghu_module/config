ngx_addon_name=ngx_http_laghu_module

LAGHU_CORE_DIR="$ngx_addon_dir/../../libs/laghu-core"
LAGHU_RUNTIME_DIR="$ngx_addon_dir/../../libs/laghu-runtime"
LAGHU_IMAGE_DIR="$ngx_addon_dir/../../libs/laghu-image"
LAGHU_MODULE_SRCS="$ngx_addon_dir/ngx_http_laghu_module.c $LAGHU_CORE_DIR/src/core.c $LAGHU_IMAGE_DIR/src/image.c $LAGHU_IMAGE_DIR/src/markup.c $LAGHU_RUNTIME_DIR/src/runtime_posix.c $LAGHU_RUNTIME_DIR/src/catalog.c $LAGHU_RUNTIME_DIR/src/html.c $LAGHU_RUNTIME_DIR/src/beacon.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP_AUX_FILTER
    ngx_module_name=ngx_http_laghu_module
    ngx_module_incs="$LAGHU_CORE_DIR/include $LAGHU_RUNTIME_DIR/include $LAGHU_IMAGE_DIR/include"
    ngx_module_srcs="$LAGHU_MODULE_SRCS"
    ngx_module_cflags="-DLAGHU_HAVE_VIPS=0"

    . auto/module
else
    HTTP_AUX_FILTER_MODULES="$HTTP_AUX_FILTER_MODULES ngx_http_laghu_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $LAGHU_MODULE_SRCS"
    CFLAGS="$CFLAGS -DLAGHU_HAVE_VIPS=0"
    CORE_INCS="$CORE_INCS $LAGHU_CORE_DIR/include $LAGHU_RUNTIME_DIR/include $LAGHU_IMAGE_DIR/include"
fi
