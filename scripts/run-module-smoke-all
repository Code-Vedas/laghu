  curl --fail --silent --dump-header \
    "${SMOKE_DIR}/javascript-inline-warm.headers" \
    --output "${SMOKE_DIR}/javascript-inline-warm" \
    "http://127.0.0.1:${PORT}/javascript-inline.html"
  if grep -i '^ETag: "laghu-html-' \
      "${SMOKE_DIR}/javascript-inline-warm.headers" >/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.1
