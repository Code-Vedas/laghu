  "http://127.0.0.1:${PORT}/inline-page.html"
grep '<style>' "${SMOKE_DIR}/inline-page-warm" >/dev/null
if grep 'href=' "${SMOKE_DIR}/inline-page-warm" >/dev/null; then
  echo "NGINX did not inline the warm stylesheet." >&2
  exit 1
fi
curl --fail --silent --output "${SMOKE_DIR}/outline-cold" \
  "http://127.0.0.1:${PORT}/outline-page.html"
cmp "${SMOKE_DIR}/html/outline-page.html" "${SMOKE_DIR}/outline-cold"
