#!/bin/sh
# Copyright Codevedas Inc. 2026-present
#
# This source code is licensed under the MIT license found in the
# LICENSE file in the root directory of this source tree.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
NGINX_VERSION="${NGINX_VERSION:-1.30.4}"
WORK_DIR="${NGINX_WORK_DIR:-${REPO_ROOT}/tmp/nginx/${NGINX_VERSION}}"
BUILD_DIR="${NGINX_BUILD_DIR:-${WORK_DIR}/build}"
SMOKE_DIR="${WORK_DIR}/smoke"
NGINX_BIN="${BUILD_DIR}/nginx"
MODULE="${BUILD_DIR}/ngx_http_laghu_module.so"
PORT="${LAGHU_SMOKE_PORT:-18080}"
ORIGIN_PORT=$((PORT + 1))
OPTIMIZER_BIN="${LAGHU_OPTIMIZER_BIN:-${REPO_ROOT}/tmp/build/workers/laghu-libvips/laghu-libvips}"
nginx_user_directive=
if [ "$(id -u)" -eq 0 ]; then
  nginx_user_directive="user root;"
fi

if [ ! -x "${NGINX_BIN}" ] || [ ! -f "${MODULE}" ]; then
  "${SCRIPT_DIR}/build-nginx-module"
fi

rm -rf "${SMOKE_DIR}"
mkdir -p "${SMOKE_DIR}/html" "${SMOKE_DIR}/logs" "${SMOKE_DIR}/cache"
printf '%s\n' '<!doctype html><title>Laghu smoke test</title>' \
  >"${SMOKE_DIR}/html/index.html"

image_smoke=0
optimizer_pid=""
printf '%s\n' '/*! keep */ .card { color: red; margin: 0  0; } /* remove */' \
  >"${SMOKE_DIR}/html/site.css"
printf '%s\n' '.inline { color: blue; margin: 0  0; } /* remove */' \
  >"${SMOKE_DIR}/html/inline.css"
printf '%s\n' '<link rel="stylesheet" href="/inline.css"><p class="inline">inline</p>' \
  >"${SMOKE_DIR}/html/inline-page.html"
awk 'BEGIN { printf "<style>"; for (i=0;i<400;i++) printf ".x { color: red; margin: 0 0; } "; printf "</style>\n" }' \
  >"${SMOKE_DIR}/html/outline-page.html"
printf '%s\n' '.combine-a { color: red; padding: 0  0; }' \
  >"${SMOKE_DIR}/html/combine-a.css"
printf '%s\n' '.combine-b { color: blue; margin: 0  0; }' \
  >"${SMOKE_DIR}/html/combine-b.css"
printf '%s\n' '.combine-c { color: green; border: 0  none; }' \
  >"${SMOKE_DIR}/html/combine-c.css"
printf '%s\n' '<link rel="stylesheet" href="/combine-a.css"> <link rel="stylesheet" href="/combine-b.css"> <link rel="stylesheet" href="/combine-c.css">' \
  >"${SMOKE_DIR}/html/combine-page.html"
printf '%s\n' '.import-leaf { color: purple; margin: 0  0  0  0; } /* remove */' \
  >"${SMOKE_DIR}/html/import-leaf.css"
printf '%s\n' '@import "/import-leaf.css" print; .import-root { padding: 0  0; }' \
  >"${SMOKE_DIR}/html/import-root.css"
import_long_name="import-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.css"
cp "${SMOKE_DIR}/html/import-leaf.css" \
  "${SMOKE_DIR}/html/${import_long_name}"
printf '%s\n' "<style>@import \"/${import_long_name}\" print;</style>" \
  >"${SMOKE_DIR}/html/import-page.html"
printf '%s\n' '<html><head><meta charset="utf-8"></head> <!--gap--><head><title>heads</title></head><body></body></html>' \
  >"${SMOKE_DIR}/html/heads-page.html"
printf '%s\n' '<html><head><script src="/app.js"></script></head><body><style media="all">.m{color:red}</style></body></html>' \
  >"${SMOKE_DIR}/html/move-page.html"
printf '%s\n' '<html><head><script src="/app.js"></script></head><body><style media="all">.m{color:red}</style></body></html>' \
  >"${SMOKE_DIR}/html/no-cross-page.html"
printf '%s\n' '<html><body><link rel="stylesheet" href="/inline.css"><p class="inline">missing head</p></body></html>' \
  >"${SMOKE_DIR}/html/missing-head-page.html"
if [ -x "${OPTIMIZER_BIN}" ] && command -v vips >/dev/null 2>&1; then
  vips black "${SMOKE_DIR}/image.v" 512 512 --bands 3
  vips pngsave "${SMOKE_DIR}/image.v" "${SMOKE_DIR}/html/image.png" \
    --compression 0
  printf '%s\n' '<!doctype html><img src="/image.png" width="320"><img src="/image.png" width="320">' \
    >"${SMOKE_DIR}/html/image-page.html"
  rm -f "${SMOKE_DIR}/image.v"
  "${OPTIMIZER_BIN}" --init "${SMOKE_DIR}/jobs.queue" \
    "${SMOKE_DIR}/cache"
  image_smoke=1
fi

cat >"${SMOKE_DIR}/nginx.conf" <<EOF
load_module ${MODULE};
${nginx_user_directive}

daemon off;
pid ${SMOKE_DIR}/nginx.pid;
error_log ${SMOKE_DIR}/logs/error.log notice;

events {}

http {
  access_log off;

  server {
    listen 127.0.0.1:${ORIGIN_PORT};
    root ${SMOKE_DIR}/html;

    location = /private {
      add_header Cache-Control private;
      return 200 'private origin';
    }

    location = /encoded-image.png {
      default_type image/png;
      add_header Content-Encoding gzip;
      try_files /image.png =404;
    }
  }

  server {
    listen 127.0.0.1:${PORT};
    root ${SMOKE_DIR}/html;
    laghu on;
    laghu preset balanced;
    laghu image_quality 82;
    laghu image_beacon on;
    laghu image_inline_limit 2048;
    laghu css_inline_limit 2048;
    laghu css_outline_threshold 8192;
    laghu image_metadata_limit 10000;
    laghu image_metadata_ttl 7d;
    laghu worker_queue ${SMOKE_DIR}/jobs.queue;
    laghu image_cache ${SMOKE_DIR}/cache;

    location = /site.css {
      default_type text/css;
      try_files /site.css =404;
    }

    location = /inline.css {
      laghu rewrite_level all;
      default_type text/css;
      try_files /inline.css =404;
    }

    location = /inline-page.html {
      laghu rewrite_level all;
      default_type text/html;
      try_files /inline-page.html =404;
    }

    location = /outline-page.html {
      laghu rewrite_level all;
      default_type text/html;
      try_files /outline-page.html =404;
    }

    location ~ ^/combine-(a|b|c)\.css$ {
      laghu rewrite_level all;
      laghu css_inline_limit 0;
      default_type text/css;
    }

    location = /combine-page.html {
      laghu rewrite_level all;
      laghu css_inline_limit 0;
      default_type text/html;
      try_files /combine-page.html =404;
    }

    location ~ ^/import-.*\.css$ {
      laghu rewrite_level all;
      default_type text/css;
    }

    location = /import-page.html {
      laghu rewrite_level all;
      default_type text/html;
      try_files /import-page.html =404;
    }

    location ~ ^/(heads-page|move-page|missing-head-page)\.html$ {
      laghu rewrite_level all;
      default_type text/html;
    }

    location = /no-cross-page.html {
      laghu rewrite_level core;
      default_type text/html;
      try_files /no-cross-page.html =404;
    }

    location = /image.png {
      default_type image/png;
      try_files /image.png =404;
    }

    location = /image-no-backend.png {
      laghu worker_queue ${SMOKE_DIR}/missing.queue;
      default_type image/png;
      alias ${SMOKE_DIR}/html/image.png;
    }

    location = /quality-image.png {
      laghu image_quality 75;
      default_type image/png;
      alias ${SMOKE_DIR}/html/image.png;
    }

    location = /unsupported.svg {
      default_type image/svg+xml;
      return 200 '<svg xmlns="http://www.w3.org/2000/svg"/>';
    }

    location = /private {
      proxy_pass http://127.0.0.1:${ORIGIN_PORT}/private;
    }

    location = /encoded-image.png {
      proxy_pass http://127.0.0.1:${ORIGIN_PORT}/encoded-image.png;
    }

    location = /api {
      default_type text/html;
      return 200 'api exact';
    }

    location /api/ {
      default_type text/html;
      return 200 'api default';
    }

    location = /api/allowed {
      laghu allow_api on;
      default_type text/html;
      return 200 'api allowed';
    }

    location = /api/private {
      laghu allow_api on;
      proxy_pass http://127.0.0.1:${ORIGIN_PORT}/private;
    }

    location = /graphql {
      default_type text/html;
      return 200 'graphql exact';
    }

    location = /graphql/query {
      default_type text/html;
      return 200 'graphql nested';
    }

    location = /apiary {
      default_type text/html;
      return 200 'api boundary';
    }

    location = /graphql-ui {
      default_type text/html;
      return 200 'graphql boundary';
    }

    location = /level/passthrough {
      laghu rewrite_level passthrough;
      default_type text/html;
      return 200 'level passthrough';
    }

    location = /level/core {
      laghu rewrite_level core;
      default_type text/html;
      return 200 'level core';
    }

    location = /level/bandwidth {
      laghu rewrite_level bandwidth;
      default_type text/html;
      return 200 'level bandwidth';
    }

    location = /level/all {
      laghu rewrite_level all;
      default_type text/html;
      return 200 'level all';
    }

    location = /level/experimental {
      laghu rewrite_level experimental;
      default_type text/html;
      return 200 'level experimental';
    }

    location = /off {
      laghu off;
      try_files /index.html =404;
    }
  }

  server {
    listen 127.0.0.1:${PORT};
    server_name rewrite-inheritance;
    laghu on;
    laghu rewrite_level passthrough;

    location = /inherited-rewrite {
      default_type text/html;
      return 200 'inherited rewrite';
    }

    location = /preset-override {
      laghu preset safe;
      default_type text/html;
      return 200 'preset override';
    }
  }
}
EOF

"${NGINX_BIN}" -t -p "${SMOKE_DIR}" -c "${SMOKE_DIR}/nginx.conf"

sed 's/laghu preset balanced;/laghu preset invalid;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/invalid-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/invalid-nginx.conf" \
    >"${SMOKE_DIR}/invalid-config-output" 2>&1; then
  echo "NGINX accepted an invalid Laghu preset." >&2
  exit 1
fi
grep 'unknown laghu preset' "${SMOKE_DIR}/invalid-config-output" >/dev/null

sed 's/laghu preset balanced;/laghu allow_api invalid;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/invalid-api-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/invalid-api-nginx.conf" \
    >"${SMOKE_DIR}/invalid-api-config-output" 2>&1; then
  echo "NGINX accepted an invalid Laghu API policy." >&2
  exit 1
fi
grep "laghu allow_api expects 'on' or 'off'" \
  "${SMOKE_DIR}/invalid-api-config-output" >/dev/null

sed 's/laghu preset balanced;/laghu allow_api on; laghu allow_api off;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/duplicate-api-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/duplicate-api-nginx.conf" \
    >"${SMOKE_DIR}/duplicate-api-config-output" 2>&1; then
  echo "NGINX accepted duplicate Laghu API policy directives." >&2
  exit 1
fi
grep 'is duplicate' "${SMOKE_DIR}/duplicate-api-config-output" >/dev/null

sed 's/laghu preset balanced;/laghu rewrite_level invalid;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/invalid-level-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/invalid-level-nginx.conf" \
    >"${SMOKE_DIR}/invalid-level-config-output" 2>&1; then
  echo "NGINX accepted an invalid Laghu rewrite level." >&2
  exit 1
fi
grep 'unknown laghu rewrite level' \
  "${SMOKE_DIR}/invalid-level-config-output" >/dev/null

sed 's/laghu preset balanced;/laghu rewrite_level core; laghu rewrite_level all;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/duplicate-level-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/duplicate-level-nginx.conf" \
    >"${SMOKE_DIR}/duplicate-level-config-output" 2>&1; then
  echo "NGINX accepted duplicate Laghu rewrite levels." >&2
  exit 1
fi
grep 'is duplicate' "${SMOKE_DIR}/duplicate-level-config-output" >/dev/null

sed 's/laghu preset balanced;/laghu preset balanced; laghu rewrite_level core;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/conflicting-policy-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/conflicting-policy-nginx.conf" \
    >"${SMOKE_DIR}/conflicting-policy-config-output" 2>&1; then
  echo "NGINX accepted conflicting Laghu policy selectors." >&2
  exit 1
fi
grep "cannot combine 'laghu preset' and 'laghu rewrite_level'" \
  "${SMOKE_DIR}/conflicting-policy-config-output" >/dev/null

sed 's/laghu image_quality 82;/laghu image_quality 101;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/invalid-quality-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/invalid-quality-nginx.conf" \
    >"${SMOKE_DIR}/invalid-quality-config-output" 2>&1; then
  echo "NGINX accepted an invalid Laghu image quality." >&2
  exit 1
fi
grep 'laghu image_quality expects an integer from 1 to 100' \
  "${SMOKE_DIR}/invalid-quality-config-output" >/dev/null

sed 's/laghu image_quality 82;/laghu image_quality 82; laghu image_quality 75;/' \
  "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/duplicate-quality-nginx.conf"
if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
    -c "${SMOKE_DIR}/duplicate-quality-nginx.conf" \
    >"${SMOKE_DIR}/duplicate-quality-config-output" 2>&1; then
  echo "NGINX accepted duplicate Laghu image quality directives." >&2
  exit 1
fi
grep 'is duplicate' "${SMOKE_DIR}/duplicate-quality-config-output" >/dev/null

for specification in \
    "css_inline_limit 70000" \
    "css_outline_threshold 1000"; do
  name=${specification%% *}
  sed "s/laghu ${name} [0-9]*;/laghu ${specification};/" \
    "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/invalid-${name}-nginx.conf"
  if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
      -c "${SMOKE_DIR}/invalid-${name}-nginx.conf" >/dev/null 2>&1; then
    echo "NGINX accepted invalid Laghu ${name}." >&2
    exit 1
  fi
done

for directive in worker_queue image_cache; do
  sed "s#laghu ${directive} #laghu ${directive} /tmp/duplicate; laghu ${directive} #" \
    "${SMOKE_DIR}/nginx.conf" >"${SMOKE_DIR}/duplicate-${directive}-nginx.conf"
  if "${NGINX_BIN}" -t -p "${SMOKE_DIR}" \
      -c "${SMOKE_DIR}/duplicate-${directive}-nginx.conf" \
      >"${SMOKE_DIR}/duplicate-${directive}-config-output" 2>&1; then
    echo "NGINX accepted duplicate Laghu ${directive} directives." >&2
    exit 1
  fi
  grep 'is duplicate' \
    "${SMOKE_DIR}/duplicate-${directive}-config-output" >/dev/null
done

if ! command -v curl >/dev/null 2>&1; then
  echo "Skipping runtime header check: curl is not installed"
  exit 0
fi

cleanup() {
  if [ "${optimizer_pid}" != "" ]; then
    kill "${optimizer_pid}" 2>/dev/null || true
  fi
  if [ -f "${SMOKE_DIR}/nginx.pid" ]; then
    kill "$(cat "${SMOKE_DIR}/nginx.pid")" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if [ "${image_smoke}" -eq 1 ]; then
  "${OPTIMIZER_BIN}" --serve "${SMOKE_DIR}/jobs.queue" \
    "${SMOKE_DIR}/cache" &
  optimizer_pid=$!
fi

"${NGINX_BIN}" -p "${SMOKE_DIR}" -c "${SMOKE_DIR}/nginx.conf" &
nginx_pid=$!
printf '%s\n' "${nginx_pid}" >"${SMOKE_DIR}/nginx.pid"

attempt=0
while [ "${attempt}" -lt 50 ]; do
  if curl --fail --silent --show-error \
      --output "${SMOKE_DIR}/body" \
      --dump-header "${SMOKE_DIR}/headers" \
      "http://127.0.0.1:${PORT}/"; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done

if [ "${attempt}" -eq 50 ]; then
  echo "NGINX did not become ready for the Laghu smoke test." >&2
  cat "${SMOKE_DIR}/logs/error.log" >&2
  exit 1
fi

grep -i '^X-Laghu: pass' "${SMOKE_DIR}/headers" >/dev/null || {
  echo "Unexpected Laghu decision for the base NGINX response:" >&2
  cat "${SMOKE_DIR}/headers" >&2
  exit 1
}
grep 'Laghu smoke test' "${SMOKE_DIR}/body" >/dev/null

if [ "${image_smoke}" -eq 1 ]; then
  curl --fail --silent --show-error \
    --header 'Accept: image/webp' \
    --output "${SMOKE_DIR}/image-cold-body" \
    --dump-header "${SMOKE_DIR}/image-cold-headers" \
    "http://127.0.0.1:${PORT}/image.png"
  tr -d '\r' <"${SMOKE_DIR}/image-cold-headers" | \
    grep -i -x 'X-Laghu: pass' >/dev/null || {
      echo "Unexpected Laghu decision for the cold NGINX image:" >&2
      cat "${SMOKE_DIR}/image-cold-headers" >&2
      exit 1
    }
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/image-cold-body"

  curl --fail --silent --show-error \
    --header 'Authorization: Bearer smoke' \
    --output "${SMOKE_DIR}/image-authorized-body" \
    --dump-header "${SMOKE_DIR}/image-authorized-headers" \
    "http://127.0.0.1:${PORT}/image.png"
  tr -d '\r' <"${SMOKE_DIR}/image-authorized-headers" | \
    grep -i -x 'X-Laghu: bypass-authorized' >/dev/null
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/image-authorized-body"

  curl --silent --show-error \
    --output "${SMOKE_DIR}/image-encoded-body" \
    --dump-header "${SMOKE_DIR}/image-encoded-headers" \
    "http://127.0.0.1:${PORT}/encoded-image.png"
  tr -d '\r' <"${SMOKE_DIR}/image-encoded-headers" | \
    grep -i -x 'X-Laghu: bypass-encoded' >/dev/null
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/image-encoded-body"

  curl --fail --silent --show-error \
    --output "${SMOKE_DIR}/quality-image-cold-body" \
    --dump-header "${SMOKE_DIR}/quality-image-cold-headers" \
    "http://127.0.0.1:${PORT}/quality-image.png"
  tr -d '\r' <"${SMOKE_DIR}/quality-image-cold-headers" | \
    grep -i -x 'X-Laghu: pass' >/dev/null
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/quality-image-cold-body"

  attempt=0
  while [ "${attempt}" -lt 100 ]; do
    if find "${SMOKE_DIR}/cache" -name 'index-*.meta' -print -quit | \
        grep . >/dev/null; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  if [ "${attempt}" -eq 100 ]; then
    echo "Laghu optimizer did not publish an image variant." >&2
    exit 1
  fi

  curl --fail --silent --show-error \
    --header 'Accept: image/webp' \
    --output "${SMOKE_DIR}/image-warm-body" \
    --dump-header "${SMOKE_DIR}/image-warm-headers" \
    "http://127.0.0.1:${PORT}/image.png"
  tr -d '\r' <"${SMOKE_DIR}/image-warm-headers" | \
    grep -i -x 'X-Laghu: image-hit' >/dev/null
  tr -d '\r' <"${SMOKE_DIR}/image-warm-headers" | \
    grep -i -E -x 'ETag: "laghu-[0-9a-f]{64}"' >/dev/null
  tr -d '\r' <"${SMOKE_DIR}/image-warm-headers" | \
    grep -i -x 'Vary: Accept' >/dev/null
  test "$(wc -c <"${SMOKE_DIR}/image-warm-body")" -lt \
    "$(wc -c <"${SMOKE_DIR}/html/image.png")"
  vipsheader "${SMOKE_DIR}/image-warm-body" >/dev/null

  curl --fail --silent --show-error \
    --output "${SMOKE_DIR}/image-page-discovery" \
    "http://127.0.0.1:${PORT}/image-page.html"
  cmp "${SMOKE_DIR}/html/image-page.html" \
    "${SMOKE_DIR}/image-page-discovery"
  curl --fail --silent --show-error --header 'Accept: image/webp' \
    --output "${SMOKE_DIR}/image-target-body" \
    "http://127.0.0.1:${PORT}/image.png"
  attempt=0
  while [ "${attempt}" -lt 100 ]; do
    curl --fail --silent --show-error \
      --dump-header "${SMOKE_DIR}/image-page-warm-headers" \
      --output "${SMOKE_DIR}/image-page-warm" \
      "http://127.0.0.1:${PORT}/image-page.html"
    if grep 'srcset=' "${SMOKE_DIR}/image-page-warm" >/dev/null; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 100 ]
  grep ' 320w' "${SMOKE_DIR}/image-page-warm" >/dev/null
  grep ' 512w' "${SMOKE_DIR}/image-page-warm" >/dev/null
  grep 'loading="lazy"' "${SMOKE_DIR}/image-page-warm" >/dev/null
  grep '/.laghu/beacon/images.js' "${SMOKE_DIR}/image-page-warm" >/dev/null
  tr -d '\r' <"${SMOKE_DIR}/image-page-warm-headers" | \
    grep -i -E -x 'ETag: "laghu-html-[0-9a-f]{64}"' >/dev/null
  curl --fail --silent --show-error \
    "http://127.0.0.1:${PORT}/.laghu/beacon/images.js" | \
    grep 'getBoundingClientRect' >/dev/null
  beacon_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --request POST --header 'Content-Type: application/json' \
    --header 'Sec-Fetch-Site: same-origin' \
    --data '{"url":"/image.png","width":240,"height":240,"viewport_width":390,"dpr_hundredths":200,"above_fold":true,"mobile":true}' \
    "http://127.0.0.1:${PORT}/.laghu/beacon/images")
  [ "${beacon_status}" = 204 ]
  beacon_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --request POST --header 'Content-Type: application/json' \
    --header 'Sec-Fetch-Site: cross-site' \
    --data '{"url":"/image.png","width":240,"height":240,"viewport_width":390,"dpr_hundredths":200,"above_fold":true,"mobile":true}' \
    "http://127.0.0.1:${PORT}/.laghu/beacon/images")
  [ "${beacon_status}" = 400 ]

  variant_file=$(find "${SMOKE_DIR}/cache" -name 'variant-*.bin' -type f | head -1)
  variant_key=${variant_file##*/variant-}
  variant_key=${variant_key%.bin}
  curl --fail --silent --show-error \
    --dump-header "${SMOKE_DIR}/hashed-variant-headers" \
    --output "${SMOKE_DIR}/hashed-variant-body" \
    "http://127.0.0.1:${PORT}/.laghu/image/${variant_key}"
  cmp "${variant_file}" "${SMOKE_DIR}/hashed-variant-body"
  tr -d '\r' <"${SMOKE_DIR}/hashed-variant-headers" | \
    grep -i -x 'Cache-Control: public, max-age=31536000, immutable' >/dev/null

  curl --fail --silent --show-error \
    --header 'Accept: image/webp;q=0, image/png' \
    --output "${SMOKE_DIR}/image-no-webp-body" \
    --dump-header "${SMOKE_DIR}/image-no-webp-headers" \
    "http://127.0.0.1:${PORT}/image.png"
  attempt=0
  while ! tr -d '\r' <"${SMOKE_DIR}/image-no-webp-headers" | \
      grep -i -x 'X-Laghu: image-hit' >/dev/null; do
    attempt=$((attempt + 1))
    if [ "${attempt}" -eq 100 ]; then
      echo "Laghu did not publish a non-WebP variant for q=0." >&2
      exit 1
    fi
    sleep 0.1
    curl --fail --silent --show-error \
      --header 'Accept: image/webp;q=0, image/png' \
      --output "${SMOKE_DIR}/image-no-webp-body" \
      --dump-header "${SMOKE_DIR}/image-no-webp-headers" \
      "http://127.0.0.1:${PORT}/image.png"
  done
  tr -d '\r' <"${SMOKE_DIR}/image-no-webp-headers" | \
    grep -i -x 'Content-Type: image/png' >/dev/null

  for variant_file in "${SMOKE_DIR}"/cache/variant-*.bin; do
    printf '\377' | dd of="${variant_file}" bs=1 count=1 conv=notrunc \
      2>/dev/null
  done
  curl --fail --silent --show-error \
    --header 'Accept: image/webp' \
    --output "${SMOKE_DIR}/image-corrupt-body" \
    --dump-header "${SMOKE_DIR}/image-corrupt-headers" \
    "http://127.0.0.1:${PORT}/image.png"
  tr -d '\r' <"${SMOKE_DIR}/image-corrupt-headers" | \
    grep -i -x 'X-Laghu: pass' >/dev/null
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/image-corrupt-body"

  curl --fail --silent --show-error \
    --output "${SMOKE_DIR}/image-no-backend-body" \
    --dump-header "${SMOKE_DIR}/image-no-backend-headers" \
    "http://127.0.0.1:${PORT}/image-no-backend.png"
  tr -d '\r' <"${SMOKE_DIR}/image-no-backend-headers" | \
    grep -i -x 'X-Laghu: bypass-image-backend' >/dev/null
  cmp "${SMOKE_DIR}/html/image.png" "${SMOKE_DIR}/image-no-backend-body"

  curl --fail --silent --show-error \
    --output "${SMOKE_DIR}/unsupported-image-body" \
    --dump-header "${SMOKE_DIR}/unsupported-image-headers" \
    "http://127.0.0.1:${PORT}/unsupported.svg"
  tr -d '\r' <"${SMOKE_DIR}/unsupported-image-headers" | \
    grep -i -x 'X-Laghu: bypass-image-backend' >/dev/null
fi

check_rewrite_level() {
  level="$1"
  expected_decision="$2"

  curl --fail --silent --show-error \
    --output "${SMOKE_DIR}/level-${level}-body" \
    --dump-header "${SMOKE_DIR}/level-${level}-headers" \
    "http://127.0.0.1:${PORT}/level/${level}"
  tr -d '\r' <"${SMOKE_DIR}/level-${level}-headers" | \
    grep -i -x "X-Laghu: ${expected_decision}" >/dev/null
  test "$(cat "${SMOKE_DIR}/level-${level}-body")" = "level ${level}"
}

check_rewrite_level passthrough bypass-passthrough
check_rewrite_level core pass
check_rewrite_level bandwidth pass
check_rewrite_level all pass
check_rewrite_level experimental pass

curl --fail --silent --show-error \
  --header 'Host: rewrite-inheritance' \
  --output "${SMOKE_DIR}/inherited-rewrite-body" \
  --dump-header "${SMOKE_DIR}/inherited-rewrite-headers" \
  "http://127.0.0.1:${PORT}/inherited-rewrite"
tr -d '\r' <"${SMOKE_DIR}/inherited-rewrite-headers" | \
  grep -i -x 'X-Laghu: bypass-passthrough' >/dev/null
test "$(cat "${SMOKE_DIR}/inherited-rewrite-body")" = 'inherited rewrite'

