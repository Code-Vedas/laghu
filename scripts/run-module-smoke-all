  "${SMOKE_DIR}/authorized-headers" >/dev/null

curl --fail --silent --show-error \
  --output /dev/null \
  --dump-header "${SMOKE_DIR}/off-headers" \
  "http://127.0.0.1:${PORT}/off"
if grep -i '^X-Laghu:' "${SMOKE_DIR}/off-headers" >/dev/null; then
  echo "Laghu emitted a decision header in a disabled location." >&2
  exit 1
fi

curl --fail --silent --show-error --output "${SMOKE_DIR}/css-cold" \
  "http://127.0.0.1:${PORT}/site.css"
cmp "${SMOKE_DIR}/html/site.css" "${SMOKE_DIR}/css-cold"
attempt=0
while [ "${attempt}" -lt 100 ]; do
  curl --fail --silent --show-error \
    --dump-header "${SMOKE_DIR}/css-warm.headers" \
    --output "${SMOKE_DIR}/css-warm" \
    "http://127.0.0.1:${PORT}/site.css"
  if ! grep 'remove' "${SMOKE_DIR}/css-warm" >/dev/null &&
      grep -i '^ETag: "laghu-css-' \
        "${SMOKE_DIR}/css-warm.headers" >/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done
grep -F '/*! keep */' "${SMOKE_DIR}/css-warm" >/dev/null
if [ "${attempt}" -eq 100 ]; then
  echo "NGINX did not serve the warm minified CSS derivation." >&2
  exit 1
fi
curl --fail --silent --show-error --output "${SMOKE_DIR}/inline-css-cold" \
  "http://127.0.0.1:${PORT}/inline.css"
cmp "${SMOKE_DIR}/html/inline.css" "${SMOKE_DIR}/inline-css-cold"
curl --fail --silent --show-error --output "${SMOKE_DIR}/inline-css-warm" \
  "http://127.0.0.1:${PORT}/inline.css"
curl --fail --silent --show-error --output "${SMOKE_DIR}/inline-page-cold" \
  "http://127.0.0.1:${PORT}/inline-page.html"
cmp "${SMOKE_DIR}/html/inline-page.html" "${SMOKE_DIR}/inline-page-cold"
curl --fail --silent --show-error --output "${SMOKE_DIR}/inline-page-warm" \
  "http://127.0.0.1:${PORT}/inline-page.html"
grep '<style>' "${SMOKE_DIR}/inline-page-warm" >/dev/null
if grep 'href=' "${SMOKE_DIR}/inline-page-warm" >/dev/null; then
  echo "NGINX did not inline the warm stylesheet." >&2
  exit 1
fi
curl --fail --silent --output "${SMOKE_DIR}/outline-cold" \
  "http://127.0.0.1:${PORT}/outline-page.html"
cmp "${SMOKE_DIR}/html/outline-page.html" "${SMOKE_DIR}/outline-cold"
curl --fail --silent --output "${SMOKE_DIR}/outline-publish" \
  "http://127.0.0.1:${PORT}/outline-page.html"
curl --fail --silent --output "${SMOKE_DIR}/outline-warm" \
  "http://127.0.0.1:${PORT}/outline-page.html"
outline_url=$(sed -n 's#.*href="\([^"]*\)".*#\1#p' "${SMOKE_DIR}/outline-warm")
case "${outline_url}" in
  /.laghu/css/????????????????????????????????????????????????????????????????) ;;
  *) echo "NGINX did not outline CSS to a hash-only route." >&2; exit 1 ;;
esac
curl --fail --silent --dump-header "${SMOKE_DIR}/outline-asset.headers" \
  --output "${SMOKE_DIR}/outline-asset.css" \
  "http://127.0.0.1:${PORT}${outline_url}"
grep -i '^Content-Type: text/css' "${SMOKE_DIR}/outline-asset.headers" >/dev/null
grep -i '^Cache-Control: public, max-age=31536000, immutable' \
  "${SMOKE_DIR}/outline-asset.headers" >/dev/null
grep -i '^ETag: "laghu-css-' "${SMOKE_DIR}/css-warm.headers" >/dev/null

for name in a b c; do
  curl --fail --silent --output "${SMOKE_DIR}/combine-${name}-cold" \
    "http://127.0.0.1:${PORT}/combine-${name}.css"
  cmp "${SMOKE_DIR}/html/combine-${name}.css" \
    "${SMOKE_DIR}/combine-${name}-cold"
  curl --fail --silent --output "${SMOKE_DIR}/combine-${name}-warm" \
    "http://127.0.0.1:${PORT}/combine-${name}.css"
done
for phase in cold settle warm; do
  curl --fail --silent --output "${SMOKE_DIR}/combine-page-${phase}" \
    "http://127.0.0.1:${PORT}/combine-page.html"
done
cmp "${SMOKE_DIR}/html/combine-page.html" "${SMOKE_DIR}/combine-page-cold"
combine_url=$(sed -n 's#.*href="\([^"]*\)".*#\1#p' \
  "${SMOKE_DIR}/combine-page-warm")
case "${combine_url}" in
  /.laghu/css/????????????????????????????????????????????????????????????????) ;;
  *) echo "NGINX did not combine CSS to a hash-only route." >&2; exit 1 ;;
esac
if [ "$(grep -o 'rel="stylesheet"' "${SMOKE_DIR}/combine-page-warm" | wc -l | tr -d ' ')" != 1 ]; then
  echo "NGINX did not replace the group with one stylesheet." >&2
  exit 1
fi
curl --fail --silent --dump-header "${SMOKE_DIR}/combine-asset.headers" \
  --output "${SMOKE_DIR}/combine-asset.css" \
  "http://127.0.0.1:${PORT}${combine_url}"
grep -i '^Content-Type: text/css' "${SMOKE_DIR}/combine-asset.headers" >/dev/null
grep -i '^Cache-Control: public, max-age=31536000, immutable' \
  "${SMOKE_DIR}/combine-asset.headers" >/dev/null
test "$(grep -n 'combine-a' "${SMOKE_DIR}/combine-asset.css" | cut -d: -f1)" -le \
  "$(grep -n 'combine-b' "${SMOKE_DIR}/combine-asset.css" | cut -d: -f1)"
test "$(grep -n 'combine-b' "${SMOKE_DIR}/combine-asset.css" | cut -d: -f1)" -le \
  "$(grep -n 'combine-c' "${SMOKE_DIR}/combine-asset.css" | cut -d: -f1)"

for path in import-leaf.css "${import_long_name}"; do
  curl --fail --silent "http://127.0.0.1:${PORT}/${path}" \
    >"${SMOKE_DIR}/${path}-cold"
  cmp "${SMOKE_DIR}/html/${path}" "${SMOKE_DIR}/${path}-cold"
  curl --fail --silent "http://127.0.0.1:${PORT}/${path}" \
    >"${SMOKE_DIR}/${path}-warm"
done
curl --fail --silent "http://127.0.0.1:${PORT}/import-root.css" \
  >"${SMOKE_DIR}/import-root-cold"
cmp "${SMOKE_DIR}/html/import-root.css" "${SMOKE_DIR}/import-root-cold"
curl --fail --silent --dump-header "${SMOKE_DIR}/import-root-warm.headers" \
  "http://127.0.0.1:${PORT}/import-root.css" \
  >"${SMOKE_DIR}/import-root-warm"
grep -F '.import-leaf' "${SMOKE_DIR}/import-root-warm" >/dev/null
if grep '@import' "${SMOKE_DIR}/import-root-warm" >/dev/null; then
  echo "NGINX did not flatten the ready CSS import." >&2
  exit 1
fi
grep -i '^ETag: "laghu-css-' "${SMOKE_DIR}/import-root-warm.headers" >/dev/null
curl --fail --silent "http://127.0.0.1:${PORT}/import-page.html" \
  >"${SMOKE_DIR}/import-page-cold"
cmp "${SMOKE_DIR}/html/import-page.html" "${SMOKE_DIR}/import-page-cold"
curl --fail --silent "http://127.0.0.1:${PORT}/import-page.html" \
  >"${SMOKE_DIR}/import-page-warm"
grep '<link rel="stylesheet" href="/.laghu/css/' \
  "${SMOKE_DIR}/import-page-warm" >/dev/null
grep 'media="print"' "${SMOKE_DIR}/import-page-warm" >/dev/null

for page in heads-page move-page; do
  curl --fail --silent --dump-header "${SMOKE_DIR}/${page}-cold.headers" \
    --output "${SMOKE_DIR}/${page}-cold" \
    "http://127.0.0.1:${PORT}/${page}.html"
  cmp "${SMOKE_DIR}/html/${page}.html" "${SMOKE_DIR}/${page}-cold"
  curl --fail --silent --dump-header "${SMOKE_DIR}/${page}-warm.headers" \
    --output "${SMOKE_DIR}/${page}-warm" \
    "http://127.0.0.1:${PORT}/${page}.html"
  grep -i '^ETag: "laghu-html-' "${SMOKE_DIR}/${page}-warm.headers" >/dev/null
done
test "$(grep -oi '<head' "${SMOKE_DIR}/heads-page-warm" | wc -l | tr -d ' ')" = 1
test "$(grep -bo '<style media="all">' "${SMOKE_DIR}/move-page-warm" | cut -d: -f1)" -lt \
  "$(grep -bo '<script src="/app.js">' "${SMOKE_DIR}/move-page-warm" | cut -d: -f1)"
curl --fail --silent --output "${SMOKE_DIR}/no-cross-page" \
  "http://127.0.0.1:${PORT}/no-cross-page.html"
cmp "${SMOKE_DIR}/html/no-cross-page.html" "${SMOKE_DIR}/no-cross-page"

curl --fail --silent --output "${SMOKE_DIR}/missing-head-cold" \
  "http://127.0.0.1:${PORT}/missing-head-page.html"
cmp "${SMOKE_DIR}/html/missing-head-page.html" "${SMOKE_DIR}/missing-head-cold"
curl --fail --silent --dump-header "${SMOKE_DIR}/missing-head-warm.headers" \
  --output "${SMOKE_DIR}/missing-head-warm" \
  "http://127.0.0.1:${PORT}/missing-head-page.html"
grep '<head><style>' "${SMOKE_DIR}/missing-head-warm" >/dev/null
grep -i '^ETag: "laghu-html-' "${SMOKE_DIR}/missing-head-warm.headers" >/dev/null

kill "${nginx_pid}"
wait "${nginx_pid}"
if [ "${optimizer_pid}" != "" ]; then
  kill "${optimizer_pid}"
  wait "${optimizer_pid}" || true
  optimizer_pid=""
fi
rm -f "${SMOKE_DIR}/nginx.pid"
trap - EXIT INT TERM

echo "Laghu NGINX module smoke test passed on ${NGINX_VERSION}."
