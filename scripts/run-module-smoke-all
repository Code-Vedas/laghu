attempt=0
while [ "${attempt}" -lt 50 ]; do
  curl --fail --silent --dump-header "${SMOKE_DIR}/javascript-warm.headers" \
    --output "${SMOKE_DIR}/javascript-warm" \
    "http://127.0.0.1:${PORT}/app.js"
  if grep -i '^ETag: "laghu-js-' "${SMOKE_DIR}/javascript-warm.headers" >/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done
test "${attempt}" -lt 50
test "$(wc -c <"${SMOKE_DIR}/javascript-warm")" -lt \
  "$(wc -c <"${SMOKE_DIR}/html/app.js")"
curl --fail --silent --output "${SMOKE_DIR}/javascript-external-warm" \
  "http://127.0.0.1:${PORT}/javascript-external.html"
if grep 'src="/app.js"' "${SMOKE_DIR}/javascript-external-warm" >/dev/null; then
  exit 1
fi
grep 'publicName(n)' "${SMOKE_DIR}/javascript-external-warm" >/dev/null
for combine_asset in combine-one.js combine-two.js; do
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent --dump-header "${SMOKE_DIR}/${combine_asset}.headers" "http://127.0.0.1:${PORT}/${combine_asset}" >/dev/null
    grep -i '^ETag: "laghu-js-' "${SMOKE_DIR}/${combine_asset}.headers" >/dev/null && break
    attempt=$((attempt + 1))
    sleep 0.1
  done
  test "${attempt}" -lt 50
done
attempt=0
while [ "${attempt}" -lt 50 ]; do
  curl --fail --silent --output "${SMOKE_DIR}/javascript-combine-warm" \
    "http://127.0.0.1:${PORT}/javascript-combine.html"
  javascript_route=$(grep -o '/\.laghu/js/[0-9a-f]\{64\}' "${SMOKE_DIR}/javascript-combine-warm" || true)
  [ "${javascript_route}" != "" ] && break
  attempt=$((attempt + 1))
  sleep 0.1
done
test "${attempt}" -lt 50
curl --fail --silent --dump-header "${SMOKE_DIR}/javascript-immutable.headers" \
  --output "${SMOKE_DIR}/javascript-immutable" \
  "http://127.0.0.1:${PORT}${javascript_route}"
