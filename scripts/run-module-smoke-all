test "${attempt}" -lt 50
grep 'function inlinePublic(n){return n+1;}' \
  "${SMOKE_DIR}/javascript-inline-warm" >/dev/null
attempt=0
while [ "${attempt}" -lt 10 ]; do
  curl --fail --silent --output "${SMOKE_DIR}/javascript-csp-hash" \
    "http://127.0.0.1:${PORT}/javascript-csp-hash.html"
  attempt=$((attempt + 1))
  sleep 0.1
done
grep 'cspProtected(longLocal)' "${SMOKE_DIR}/javascript-csp-hash" >/dev/null
if grep 'cspProtected(n)' "${SMOKE_DIR}/javascript-csp-hash" >/dev/null; then
  echo "Hash-authorized inline JavaScript was modified." >&2
  exit 1
fi
curl --fail --silent --output "${SMOKE_DIR}/javascript-outline-cold" "http://127.0.0.1:${PORT}/javascript-outline.html"
attempt=0
while [ "${attempt}" -lt 50 ]; do
  curl --fail --silent --output "${SMOKE_DIR}/javascript-outline-warm" "http://127.0.0.1:${PORT}/javascript-outline.html"
  outline_route=$(grep -o '/\.laghu/js/[0-9a-f]\{64\}' "${SMOKE_DIR}/javascript-outline-warm" || true)
  [ "${outline_route}" != "" ] && break
  attempt=$((attempt + 1))
  sleep 0.1
done
test "${attempt}" -lt 50
curl --fail --silent "http://127.0.0.1:${PORT}${outline_route}" | grep 'outlinePublic' >/dev/null

kill "${nginx_pid}"
wait "${nginx_pid}"
if [ "${optimizer_pid}" != "" ]; then
  kill "${optimizer_pid}"
  wait "${optimizer_pid}" || true
  optimizer_pid=""
fi
if [ "${javascript_pid}" != "" ]; then
  kill "${javascript_pid}"
  wait "${javascript_pid}" || true
  javascript_pid=""
fi
rm -f "${SMOKE_DIR}/nginx.pid"
trap - EXIT INT TERM

echo "Laghu NGINX module smoke test passed on ${NGINX_VERSION}."
