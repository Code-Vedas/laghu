#!/bin/sh
# Copyright Codevedas Inc. 2026-present
#
# This source code is licensed under the MIT license found in the
# LICENSE file in the root directory of this source tree.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
APXS=${APXS:-}
HTTPD=${HTTPD:-}

if [ -z "${APXS}" ]; then
  APXS=$(command -v apxs 2>/dev/null || command -v apxs2 2>/dev/null || true)
fi
if [ -z "${HTTPD}" ]; then
  HTTPD=$(command -v apache2 2>/dev/null || command -v httpd 2>/dev/null || true)
fi
if [ -z "${APXS}" ] || [ -z "${HTTPD}" ]; then
  echo "Apache httpd and apxs are required for the mod_laghu smoke test." >&2
  exit 127
fi

"${SCRIPT_DIR}/build-apache-module"

work=${APACHE_SMOKE_DIR:-"${REPO_ROOT}/tmp/apache-smoke"}
module="${REPO_ROOT}/tmp/apache-module/.libs/mod_laghu.so"
modules=$(${APXS} -q LIBEXECDIR)
service=${LAGHU_SERVICE:-"${REPO_ROOT}/tmp/build/workers/laghu-libvips/laghu-libvips"}
javascript_service=${LAGHU_JAVASCRIPT_BIN:-"${REPO_ROOT}/tmp/build/workers/laghu-js-optimize/cargo/release/laghu-js-optimize"}
status_bin=${LAGHU_STATUS_BIN:-"${REPO_ROOT}/tmp/build/servers/laghu/laghu"}
service_pid=
javascript_pid=
origin_pid=
rm -rf "${work}"
mkdir -p "${work}/htdocs" "${work}/logs" "${work}/cache" \
  "${work}/asset-catalog" "${work}/asset-queue"
cat >"${work}/assets.conf" <<EOF
version=1
source_domain=https://origin.example.test
public_domain=https://cdn.example.test
source_prefix=/assets
public_prefix=/immutable
mime_types=image/png,text/css,application/javascript
mode=rewrite_only
catalog_path=${work}/asset-catalog
queue_path=${work}/asset-queue
endpoint=https://s3.example.test
region=test-1
bucket=assets
access_key_env=LAGHU_TEST_ACCESS_KEY
secret_key_env=LAGHU_TEST_SECRET_KEY
EOF
printf '%s\n' 'apache-purge-token-0123456789' >"${work}/purge.token"
chmod 600 "${work}/purge.token"
printf '%s\n' 'apache laghu smoke' >"${work}/htdocs/index.html"
printf '%s\n' '<!doctype html><body><nav><img src="/logo.png" width="40" height="40"></nav><img src="/hero.jpg" width="800" height="600"><img src="/later.jpg" loading="lazy"></body>' \
  >"${work}/htdocs/lcp.html"
printf '%s\n' '/*! keep */ .card { color: red; margin: 0  0; } /* remove */' \
  >"${work}/htdocs/site.css"
printf '%s\n' '.inline { color: blue; margin: 0  0; } /* remove */' \
  >"${work}/htdocs/inline.css"
printf '%s\n' '<link rel="stylesheet" href="/inline.css"><p class="inline">inline</p>' \
  >"${work}/htdocs/inline-page.html"
awk 'BEGIN { printf "<style>"; for (i=0;i<400;i++) printf ".x { color: red; margin: 0 0; } "; printf "</style>\n" }' \
  >"${work}/htdocs/outline-page.html"
printf '%s\n' '.combine-a { color: red; padding: 0  0; }' \
  >"${work}/htdocs/combine-a.css"
printf '%s\n' '.combine-b { color: blue; margin: 0  0; }' \
  >"${work}/htdocs/combine-b.css"
printf '%s\n' '.combine-c { color: green; border: 0  none; }' \
  >"${work}/htdocs/combine-c.css"
printf '%s\n' '<link rel="stylesheet" href="/combine-a.css"> <link rel="stylesheet" href="/combine-b.css"> <link rel="stylesheet" href="/combine-c.css">' \
  >"${work}/htdocs/combine-page.html"
printf '%s\n' '.import-leaf { color: purple; margin: 0  0  0  0; } /* remove */' \
  >"${work}/htdocs/import-leaf.css"
printf '%s\n' '@import "/import-leaf.css" print; .import-root { padding: 0  0; }' \
  >"${work}/htdocs/import-root.css"
import_long_name="import-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.css"
cp "${work}/htdocs/import-leaf.css" "${work}/htdocs/${import_long_name}"
printf '%s\n' "<style>@import \"/${import_long_name}\" print;</style>" \
  >"${work}/htdocs/import-page.html"
printf '%s\n' '<html><head><meta charset="utf-8"></head> <!--gap--><head><title>heads</title></head><body></body></html>' \
  >"${work}/htdocs/heads-page.html"
printf '%s\n' '<html><head><script src="/barrier.js"></script></head><body><style media="all">.m{color:red}</style></body></html>' \
  >"${work}/htdocs/move-page.html"
printf '%s\n' '<html><head><script src="/barrier.js"></script></head><body><style media="all">.m{color:red}</style></body></html>' \
  >"${work}/htdocs/no-cross-page.html"
printf '%s\n' '<html><body><link rel="stylesheet" href="/inline.css"><p class="inline">missing head</p></body></html>' \
  >"${work}/htdocs/missing-head-page.html"
printf '%s\n' '<html><body><!-- remove --><p class="safe" title="two words">one   two</p><audio src="/asset.mp3?q=1#hero"></audio><script type="text/javascript"> x  y </script><pre> a  b </pre><!-- @license keep --></body></html>' \
  >"${work}/htdocs/minify-page.html"
printf '%s\n' '<!doctype html><html><head><meta http-equiv="Content-Language" content="en-CA"><link rel="preconnect" href="https://reserved.example.test"></head><body><script src="https://cdn.example.test/app.js?token=secret#part"></script></body></html>' \
  >"${work}/htdocs/hints-page.html"
printf '%s\n' 'function publicName(longLocal) { return longLocal + 1; }' \
  >"${work}/htdocs/app.js"
printf '%s\n' '<html><body><script>function inlinePublic(longLocal) { return longLocal + 1; }</script></body></html>' \
  >"${work}/htdocs/javascript-inline.html"
printf '%s\n' '<html><head><meta http-equiv="Content-Security-Policy" content="script-src '\''sha256-YWJjZA=='\''"></head><body><script>function cspProtected(longLocal) { return longLocal + 1; }</script></body></html>' \
  >"${work}/htdocs/javascript-csp-hash.html"
printf '%s\n' '<html><body><script src="/app.js"></script><script>function externalPageHelper(veryLongLocalArgument) { return veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument + veryLongLocalArgument; }</script></body></html>' \
  >"${work}/htdocs/javascript-external.html"
printf '%s\n' '<html><body>rum<script src="/app.js"></script></body></html>' \
  >"${work}/htdocs/instrumentation.html"
printf '%s\n' "                                                                                                                                                                console.log('combine one value'); console.log('combine one value again');" >"${work}/htdocs/combine-one.js"
printf '%s\n' "                                                                                                                                                                console.log('combine two value'); console.log('combine two value again');" >"${work}/htdocs/combine-two.js"
printf '%s\n' '<html><body><script src="/combine-one.js" data-laghu-combine="application-main"></script><script src="/combine-two.js" data-laghu-combine="application-main"></script></body></html>' >"${work}/htdocs/javascript-combine.html"
awk 'BEGIN { printf "<html><body><script>function outlinePublic(veryLongLocalArgument){return "; for (i=0;i<500;i++) printf "%sveryLongLocalArgument", i ? "+" : ""; print ";}</script></body></html>" }' >"${work}/htdocs/javascript-outline.html"

load_if_present() {
  name=$1
  file=$2
  if [ -f "${modules}/${file}" ]; then
    printf 'LoadModule %s_module "%s/%s"\n' "${name}" "${modules}" "${file}"
  fi
}

load_first_mpm() {
  if [ -n "${APACHE_MPM:-}" ]; then
    file="mod_mpm_${APACHE_MPM}.so"
    if "${HTTPD}" -l 2>/dev/null | grep -q "mpm_${APACHE_MPM}\.c"; then
      return
    fi
    if [ ! -f "${modules}/${file}" ]; then
      echo "Apache MPM ${APACHE_MPM} is unavailable in ${modules}." >&2
      exit 2
    fi
    printf 'LoadModule mpm_%s_module "%s/%s"\n' "${APACHE_MPM}" "${modules}" "${file}"
    return
  fi
  for specification in \
      "mpm_event mod_mpm_event.so" \
      "mpm_worker mod_mpm_worker.so" \
      "mpm_prefork mod_mpm_prefork.so"; do
    name=${specification%% *}
    file=${specification#* }
    if [ -f "${modules}/${file}" ]; then
      printf 'LoadModule %s_module "%s/%s"\n' "${name}" "${modules}" "${file}"
      return
    fi
  done
}

{
  printf 'ServerRoot "%s"\n' "${work}"
  printf 'PidFile "%s/logs/httpd.pid"\n' "${work}"
  printf 'Listen 127.0.0.1:18081\n'
  printf 'ServerName localhost\n'
  load_first_mpm
  load_if_present unixd mod_unixd.so
  load_if_present authz_core mod_authz_core.so
  load_if_present mime mod_mime.so
  load_if_present log_config mod_log_config.so
  load_if_present headers mod_headers.so
  load_if_present proxy mod_proxy.so
  load_if_present proxy_http mod_proxy_http.so
  load_if_present http2 mod_http2.so
  if [ -f /etc/mime.types ]; then
    printf 'TypesConfig "/etc/mime.types"\n'
  fi
  printf 'LoadModule laghu_module "%s"\n' "${module}"
  printf 'DocumentRoot "%s/htdocs"\n' "${work}"
  printf '<Directory "%s/htdocs">\nRequire all granted\n</Directory>\n' "${work}"
  printf 'ErrorLog "%s/logs/error.log"\n' "${work}"
  printf 'Laghu On\nLaghu RewriteLevel passthrough\n'
  printf 'Laghu TransformMemoryLimit 32m\nLaghu TransformDeadlineMs 50\nLaghu VariantsPerSource 16\n'
  printf 'Laghu AllowResources "/*"\nLaghu Disallow "/never-optimized/*"\n'
  printf 'Laghu RespectVary On\nLaghu QueryFilterOverrides On\n'
  printf 'Laghu RespectXForwardedProto On\nLaghu TrustedProxy 127.0.0.1/32\n'
  printf 'Laghu RumStore local:%s/rum.snapshot\n' "${work}"
  printf 'Laghu RumStoreSyncInterval 1\n'
  printf 'Laghu RumStoreMemoryLimit 8m\n'
  printf 'Laghu RumStorePendingLimit 1m\n'
  printf 'Laghu ImageBeacon On\nLaghu ImageInlineLimit 2048\n'
  printf 'Laghu CriticalCssBeacon On\n'
  printf 'Laghu CssInlineLimit 2048\nLaghu CssOutlineThreshold 8192\n'
  printf 'Laghu ImageMetadataLimit 10000\nLaghu ImageMetadataTtl 7d\n'
  printf '<Location "/site.css">\nLaghu RewriteLevel core\n</Location>\n'
  printf '<Location "/filter-policy">\nLaghu RewriteLevel core\nLaghu EnableFilter resource_inline\nLaghu DisableFilter html_minify\nLaghu ForbidFilter javascript_defer\n</Location>\n'
  printf '<Location "/inline.css">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<Location "/inline-page.html">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<Location "/outline-page.html">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<LocationMatch "^/combine-(a|b|c)\\.css$">\nLaghu RewriteLevel all\nLaghu CssInlineLimit 0\n</LocationMatch>\n'
  printf '<Location "/combine-page.html">\nLaghu RewriteLevel all\nLaghu CssInlineLimit 0\n</Location>\n'
  printf '<LocationMatch "^/import-.*\\.css$">\nLaghu RewriteLevel all\n</LocationMatch>\n'
  printf '<Location "/import-page.html">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<LocationMatch "^/(heads-page|move-page|missing-head-page)\\.html$">\nLaghu RewriteLevel all\n</LocationMatch>\n'
  printf '<Location "/no-cross-page.html">\nLaghu RewriteLevel core\n</Location>\n'
  printf '<Location "/minify-page.html">\nLaghu RewriteLevel bandwidth\n</Location>\n'
  printf '<Location "/hints-page.html">\nLaghu RewriteLevel core\nHeader always add Link "<https://origin.example.test>; rel=preload"\n</Location>\n'
  printf '<Location "/app.js">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<Location "/javascript-inline.html">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<Location "/javascript-external.html">\nLaghu RewriteLevel all\n</Location>\n'
  printf '<Location "/instrumentation.html">\nLaghu RewriteLevel core\nLaghu InstrumentationBeacon On\nLaghu InstrumentationSampleRate 100\n</Location>\n'
  printf '<Location "/.laghu/beacon/instrumentation.js">\nLaghu On\nLaghu InstrumentationBeacon On\n</Location>\n'
  printf '<Location "/.laghu/beacon/instrumentation">\nLaghu On\nLaghu InstrumentationBeacon On\n</Location>\n'
  printf '<LocationMatch "^/(combine-(one|two)\\.js|javascript-(combine|outline)\\.html)$">\nLaghu RewriteLevel all\n</LocationMatch>\n'
  printf 'Laghu FileCacheBackend "file://%s/cache"\n' "${work}"
  printf 'Laghu FileCacheSize 10g\n'
  printf 'Laghu FileCacheInodeLimit 100000\n'
  printf 'Laghu FileCacheCleanInterval 60s\n'
  printf 'Laghu FileCacheMetadataSize 16m\n'
  printf 'Laghu PurgeMethod PURGE\n'
  printf 'Laghu PurgeQuery On\n'
  printf 'Laghu PurgeTokenFile "%s/purge.token"\n' "${work}"
  printf 'Laghu PurgeAllow 127.0.0.1/32\n'
  printf 'Laghu Statistics On\n'
  printf 'Laghu Metrics On\nLaghu Readiness On\nLaghu ReadinessPolicy Degraded\n'
  printf 'Laghu AssetOffloadConfig "%s/assets.conf"\n' "${work}"
  printf 'Laghu AssetUploadQueue "%s/asset-queue"\n' "${work}"
  printf 'Laghu LoadFromFile Mapped\n'
  printf 'Laghu FileSourceMap "https://origin.example.test/assets/" "%s/htdocs"\n' "${work}"
  printf 'Laghu Domain https://authorized.example.test\n'
  printf 'Laghu MapProxyDomain https://proxy.example.test https://origin.example.test\n'
  printf 'Laghu ShardDomain https://proxy.example.test https://one.example.test,https://two.example.test\n'
  if [ -x "${javascript_service}" ]; then
    printf 'Laghu JavaScriptQueue "%s/javascript.queue"\n' "${work}"
    printf 'Laghu JavaScriptTarget "last 2 chrome versions"\n'
    printf 'Laghu IncludeJsSourceMaps On\n'
    printf 'Laghu JavaScriptInlineLimit 2048\n'
    printf 'Laghu JavaScriptOutlineThreshold 8192\n'
  fi
  printf '<Location "/.laghu/">\nLaghu RewriteLevel core\nLaghu InstrumentationBeacon On\n</Location>\n'
  printf 'ProxyPass "/proxied/" "http://127.0.0.1:18082/"\n'
  if [ -f "${modules}/mod_http2.so" ]; then
    printf 'Protocols h2c http/1.1\nH2Direct on\n'
  fi
  if [ -x "${service}" ] && command -v vips >/dev/null 2>&1; then
    printf 'Laghu WorkerQueue "%s/jobs.queue"\n' "${work}"
    printf '<Location "/image.png">\nLaghu RewriteLevel core\n</Location>\n'
    printf '<Location "/image-page.html">\nLaghu RewriteLevel core\n</Location>\n'
    printf 'AddType image/png .png\n'
  fi
  printf '<Location "/lcp.html">\nLaghu RewriteLevel core\n</Location>\n'
} >"${work}/httpd.conf"

cat >"${work}/origin.rb" <<'RUBY'
# Copyright Codevedas Inc. 2026-present
#
# This source code is licensed under the MIT license found in the
# LICENSE file in the root directory of this source tree.

require "socket"

server = TCPServer.new("127.0.0.1", 18_082)
loop do
  socket = server.accept
  socket.gets
  loop do
    line = socket.gets
    break if line.nil? || line == "\r\n"
  end
  socket.write("HTTP/1.1 200 OK\r\n")
  socket.write("Content-Type: text/plain\r\n")
  socket.write("Transfer-Encoding: chunked\r\n")
  socket.write("Connection: close\r\n\r\n")
  ["brigade-", "flush-", "eos\n"].each do |part|
    socket.write("#{part.bytesize.to_s(16)}\r\n#{part}\r\n")
    socket.flush
    sleep(0.03)
  end
  socket.write("0\r\n\r\n")
  socket.close
end
RUBY
ruby "${work}/origin.rb" >"${work}/logs/origin.log" 2>&1 &
origin_pid=$!

if [ -x "${service}" ] && command -v vips >/dev/null 2>&1; then
  vips black "${work}/source.v" 512 512 --bands 3
  vips pngsave "${work}/source.v" "${work}/htdocs/image.png" --compression 0
  printf '%s\n' '<!doctype html><img src="/image.png" width="320"><img src="/image.png" width="320">' \
    >"${work}/htdocs/image-page.html"
  rm -f "${work}/source.v"
  "${service}" --init-and-serve "${work}/jobs.queue" "${work}/cache" &
  service_pid=$!
fi
if [ -x "${javascript_service}" ]; then
  "${javascript_service}" --init-and-serve "${work}/javascript.queue" \
    "${work}/cache" &
  javascript_pid=$!
fi

"${HTTPD}" -t -f "${work}/httpd.conf"
cp "${work}/httpd.conf" "${work}/invalid-filter.conf"
printf 'Laghu EnableFilter unknown\n' >>"${work}/invalid-filter.conf"
if "${HTTPD}" -t -f "${work}/invalid-filter.conf" >/dev/null 2>&1; then
  echo "Apache accepted an unknown Laghu filter." >&2
  exit 1
fi
sed 's/Laghu DisableFilter html_minify/Laghu DisableFilter resource_inline/' \
  "${work}/httpd.conf" >"${work}/conflicting-filter.conf"
if "${HTTPD}" -t -f "${work}/conflicting-filter.conf" >/dev/null 2>&1; then
  echo "Apache accepted conflicting Laghu filter controls." >&2
  exit 1
fi
cp "${work}/httpd.conf" "${work}/duplicate.conf"
printf 'Laghu On\n' >>"${work}/duplicate.conf"
if "${HTTPD}" -t -f "${work}/duplicate.conf" >/dev/null 2>&1; then
  echo "Apache accepted a duplicate Laghu directive." >&2
  exit 1
fi
cp "${work}/httpd.conf" "${work}/conflict.conf"
printf 'Laghu Preset balanced\n' >>"${work}/conflict.conf"
if "${HTTPD}" -t -f "${work}/conflict.conf" >/dev/null 2>&1; then
  echo "Apache accepted conflicting Laghu selectors." >&2
  exit 1
fi
for specification in "CssInlineLimit 70000" "CssOutlineThreshold 1000"; do
  name=${specification%% *}
  sed "s/Laghu ${name} [0-9]*/Laghu ${specification}/" \
    "${work}/httpd.conf" >"${work}/invalid-css.conf"
  if "${HTTPD}" -t -f "${work}/invalid-css.conf" >/dev/null 2>&1; then
    echo "Apache accepted invalid Laghu ${specification}." >&2
    exit 1
  fi
done
if command -v setsid >/dev/null 2>&1; then
  setsid "${HTTPD}" -f "${work}/httpd.conf" -DFOREGROUND &
else
  "${HTTPD}" -f "${work}/httpd.conf" -DFOREGROUND &
fi
pid=$!
trap 'kill "${pid}" ${service_pid:-} ${javascript_pid:-} ${origin_pid:-} 2>/dev/null || true; wait "${pid}" ${service_pid:-} ${javascript_pid:-} ${origin_pid:-} 2>/dev/null || true' EXIT

attempt=0
while [ "${attempt}" -lt 50 ]; do
  if curl --fail --silent --dump-header "${work}/headers" \
      http://127.0.0.1:18081/index.html >"${work}/body"; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done
[ "${attempt}" -lt 50 ] || {
  echo "Apache did not serve the smoke-test response." >&2
  if [ -f "${work}/logs/error.log" ]; then
    cat "${work}/logs/error.log" >&2
  fi
  exit 1
}
cmp "${work}/htdocs/index.html" "${work}/body"
grep -i '^X-Laghu: bypass-passthrough' "${work}/headers"
grep -i '^X-Laghu-Cache: bypass' "${work}/headers"
grep -i '^X-Laghu-Transform: pass' "${work}/headers"
curl --fail --silent \
  -H 'X-Laghu-Purge-Token: apache-purge-token-0123456789' \
  http://127.0.0.1:18081/.laghu/stats | grep 'laghu-cache-stats-v1' >/dev/null
if [ ! -x "${status_bin}" ]; then
  echo "Laghu status executable not found: ${status_bin}" >&2
  exit 1
fi
"${status_bin}" status http://127.0.0.1:18081 \
  --token-file "${work}/purge.token" --json | \
  grep '"schema":"laghu-status-v1"' >/dev/null
"${status_bin}" doctor http://127.0.0.1:18081 \
  --token-file "${work}/purge.token" --json | \
  grep '"schema":"laghu-doctor-v1"' >/dev/null
"${status_bin}" purge http://127.0.0.1:18081/site.css \
  --token-file "${work}/purge.token" --json | \
  grep '"schema":"laghu-purge-v1"' >/dev/null
curl --fail --silent --dump-header "${work}/lcp.headers" \
  http://127.0.0.1:18081/lcp.html >"${work}/lcp.html"
grep 'fetchpriority=\("\)\?high\("\)\?' "${work}/lcp.html" >/dev/null
grep 'later.jpg.*loading=.*lazy' "${work}/lcp.html" >/dev/null
tr -d '\r' <"${work}/lcp.headers" | \
  grep -i -E -x 'Link: </hero.jpg>; rel=preload; as=image' >/dev/null
tr -d '\r' <"${work}/lcp.headers" | awk '
  /^HTTP\/1\.1 103 Early Hints$/ { early = 1; next }
  early && /^Link: <\/hero\.jpg>; rel=preload; as=image$/ { link = 1 }
  early && /^$/ { exit link ? 0 : 1 }
  END { exit early && link ? 0 : 1 }
'
curl --fail --silent -X PURGE \
  -H 'X-Laghu-Purge-Token: apache-purge-token-0123456789' \
  http://127.0.0.1:18081/site.css | grep 'accepted' >/dev/null

if [ -x "${javascript_service}" ]; then
  curl --fail --silent http://127.0.0.1:18081/app.js >"${work}/javascript-cold"
  cmp "${work}/htdocs/app.js" "${work}/javascript-cold"
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent --dump-header "${work}/javascript-warm.headers" \
      http://127.0.0.1:18081/app.js >"${work}/javascript-warm"
    if grep -i '^ETag: "laghu-js-' "${work}/javascript-warm.headers" >/dev/null; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 50 ]
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent http://127.0.0.1:18081/javascript-external.html >"${work}/javascript-external-warm"
    ! grep 'src="/app.js"' "${work}/javascript-external-warm" >/dev/null && break
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 50 ]
  grep 'publicName(n)' "${work}/javascript-external-warm" >/dev/null
  for combine_asset in combine-one.js combine-two.js; do
    attempt=0
    while [ "${attempt}" -lt 50 ]; do
      curl --fail --silent --dump-header "${work}/${combine_asset}.headers" "http://127.0.0.1:18081/${combine_asset}" >/dev/null
      grep -i '^ETag: "laghu-js-' "${work}/${combine_asset}.headers" >/dev/null && break
      attempt=$((attempt + 1))
      sleep 0.1
    done
    [ "${attempt}" -lt 50 ]
  done
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent http://127.0.0.1:18081/javascript-combine.html >"${work}/javascript-combine-warm"
    javascript_route=$(grep -o '/\.laghu/js/[0-9a-f]\{64\}' "${work}/javascript-combine-warm" || true)
    [ "${javascript_route}" != "" ] && break
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 50 ]
  curl --fail --silent --dump-header "${work}/javascript-immutable.headers" \
    "http://127.0.0.1:18081${javascript_route}" \
    >"${work}/javascript-immutable"
  grep 'combine one value' "${work}/javascript-immutable" >/dev/null
  grep 'combine two value' "${work}/javascript-immutable" >/dev/null
  javascript_map_route=$(grep -o '/\.laghu/js/[0-9a-f]\{64\}\.map' \
    "${work}/javascript-immutable")
  [ "${javascript_map_route}" != "" ]
  curl --fail --silent --dump-header "${work}/javascript-map.headers" \
    "http://127.0.0.1:18081${javascript_map_route}" \
    >"${work}/javascript-map"
  grep '"version":3' "${work}/javascript-map" >/dev/null
  grep '"sections":\[' "${work}/javascript-map" >/dev/null
  grep -i '^Content-Type: application/json' \
    "${work}/javascript-map.headers" >/dev/null
  grep -i '^Cache-Control: public, max-age=31536000, immutable' \
    "${work}/javascript-immutable.headers" >/dev/null
  curl --fail --silent http://127.0.0.1:18081/javascript-inline.html \
    >"${work}/javascript-inline-cold"
  cmp "${work}/htdocs/javascript-inline.html" \
    "${work}/javascript-inline-cold"
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent --dump-header \
      "${work}/javascript-inline-warm.headers" \
      http://127.0.0.1:18081/javascript-inline.html \
      >"${work}/javascript-inline-warm"
    if grep -i '^ETag: "laghu-html-' \
        "${work}/javascript-inline-warm.headers" >/dev/null; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 50 ]
  grep 'function inlinePublic(n){return n+1;}' \
    "${work}/javascript-inline-warm" >/dev/null
  attempt=0
  while [ "${attempt}" -lt 10 ]; do
    curl --fail --silent http://127.0.0.1:18081/javascript-csp-hash.html \
      >"${work}/javascript-csp-hash"
    attempt=$((attempt + 1))
    sleep 0.1
  done
  grep 'cspProtected(longLocal)' "${work}/javascript-csp-hash" >/dev/null
  if grep 'cspProtected(n)' "${work}/javascript-csp-hash" >/dev/null; then
    echo "Hash-authorized inline JavaScript was modified." >&2
    exit 1
  fi
  curl --fail --silent http://127.0.0.1:18081/javascript-outline.html >"${work}/javascript-outline-cold"
  attempt=0
  while [ "${attempt}" -lt 50 ]; do
    curl --fail --silent http://127.0.0.1:18081/javascript-outline.html >"${work}/javascript-outline-warm"
    outline_route=$(grep -o '/\.laghu/js/[0-9a-f]\{64\}' "${work}/javascript-outline-warm" || true)
    [ "${outline_route}" != "" ] && break
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 50 ]
  curl --fail --silent "http://127.0.0.1:18081${outline_route}" | grep 'outlinePublic' >/dev/null
fi

