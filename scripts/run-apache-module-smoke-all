  http_version=$(curl --fail --silent --http2-prior-knowledge \
    --write-out '%{http_version}' --output "${work}/proxy-http2.body" \
    http://127.0.0.1:18081/proxied/stream)
  [ "${http_version}" = 2 ]
  cmp "${work}/expected-stream" "${work}/proxy-http2.body"
