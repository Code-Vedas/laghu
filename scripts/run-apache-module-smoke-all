if [ "${service_pid}" != "" ]; then
  curl --fail --silent \
    http://127.0.0.1:18081/image-page.html >"${work}/image-page-discovery.html"
  cmp "${work}/htdocs/image-page.html" "${work}/image-page-discovery.html"
  curl --fail --silent --dump-header "${work}/image-cold.headers" \
    http://127.0.0.1:18081/image.png >"${work}/image-cold.png"
  cmp "${work}/htdocs/image.png" "${work}/image-cold.png"
  attempt=0
  while [ "${attempt}" -lt 100 ] &&
      [ "$(find "${work}/cache" -name '*.meta' -type f | wc -l | tr -d ' ')" -lt 2 ]; do
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 100 ] || {
    echo "laghu-libvips did not publish the Apache image variant." >&2
    exit 1
  }
  attempt=0
  original_image_size=$(wc -c <"${work}/htdocs/image.png")
  while [ "${attempt}" -lt 100 ]; do
    curl --fail --silent --dump-header "${work}/image-warm.headers" \
      http://127.0.0.1:18081/image.png >"${work}/image-warm.png"
    if grep -i '^X-Laghu: image-hit' "${work}/image-warm.headers" >/dev/null &&
        [ "$(wc -c <"${work}/image-warm.png")" -lt \
          "${original_image_size}" ]; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 100 ] || {
    echo "Apache did not serve a smaller warm image variant." >&2
    exit 1
  }
  grep -i '^X-Laghu: image-hit' "${work}/image-warm.headers"
  test "$(wc -c <"${work}/image-warm.png")" -lt "${original_image_size}"
  curl --fail --silent --show-error http://127.0.0.1:18081/image-page.html \
    >"${work}/image-page-targets.html"
  curl --fail --silent --show-error http://127.0.0.1:18081/image.png \
    >"${work}/image-target.png"
  attempt=0
  while [ "${attempt}" -lt 100 ]; do
    curl --fail --silent --show-error \
      --dump-header "${work}/image-page-warm.headers" \
      http://127.0.0.1:18081/image-page.html >"${work}/image-page-warm.html"
    if grep 'srcset=' "${work}/image-page-warm.html" >/dev/null &&
        grep ' 320w' "${work}/image-page-warm.html" >/dev/null &&
        grep ' 512w' "${work}/image-page-warm.html" >/dev/null &&
        grep 'loading=lazy' "${work}/image-page-warm.html" >/dev/null &&
        grep '/.laghu/beacon/images.js' \
          "${work}/image-page-warm.html" >/dev/null &&
        grep -i -E '^Link: </.laghu/image/[0-9a-f]{64}>; rel=preload; as=image' \
          "${work}/image-page-warm.headers" >/dev/null &&
        grep -i -E '^ETag: "laghu-html-[0-9a-f]{64}"' \
          "${work}/image-page-warm.headers" >/dev/null; then
      break
    fi
    # Discovery and queue publication are deliberately try-only. A catalog
    # writer may be contended, so revisit the source between page attempts to
    # submit any targets published by the latest discovery pass.
    curl --fail --silent --show-error http://127.0.0.1:18081/image.png \
      >"${work}/image-target.png"
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ "${attempt}" -lt 100 ] || {
    echo "Apache did not serve the complete warm responsive image markup." >&2
    echo "Last response headers:" >&2
    cat "${work}/image-page-warm.headers" >&2
    echo "Last response body:" >&2
    cat "${work}/image-page-warm.html" >&2
    echo "Published catalog metadata:" >&2
    find "${work}/cache" -name '*.meta' -type f -print >&2
    exit 1
  }
  grep ' 320w' "${work}/image-page-warm.html" >/dev/null
  grep ' 512w' "${work}/image-page-warm.html" >/dev/null
  grep 'loading=lazy' "${work}/image-page-warm.html" >/dev/null
  [ "$(grep -o 'loading=lazy' "${work}/image-page-warm.html" | wc -l | tr -d ' ')" -eq 1 ]
  grep '/.laghu/beacon/images.js' "${work}/image-page-warm.html" >/dev/null
  grep -i -E '^ETag: "laghu-html-[0-9a-f]{64}"' \
    "${work}/image-page-warm.headers"
  curl --fail --silent \
    http://127.0.0.1:18081/.laghu/beacon/images.js | \
    grep 'getBoundingClientRect' >/dev/null
  curl --fail --silent \
    http://127.0.0.1:18081/.laghu/beacon/critical-css.js | \
    grep 'data-laghu-critical' >/dev/null
  curl --fail --silent http://127.0.0.1:18081/instrumentation.html \
    >"${work}/instrumentation.html"
  grep 'data-laghu-sample="100"' "${work}/instrumentation.html" >/dev/null
  instrumentation_script_status=$(curl --silent --output "${work}/instrumentation.js" \
    --write-out '%{http_code}' \
    http://127.0.0.1:18081/.laghu/beacon/instrumentation.js)
  [ "${instrumentation_script_status}" = 200 ] || {
    echo "Instrumentation script returned ${instrumentation_script_status}" >&2
    exit 1
  }
  grep 'largest-contentful-paint' "${work}/instrumentation.js" >/dev/null
  instrumentation_key=$(sed -n 's/.*data-laghu-template="\([0-9a-f]\{64\}\)".*/\1/p' \
    "${work}/instrumentation.html")
  instrumentation_status=0
  attempt=0
  while [ "${instrumentation_status}" != 204 ] && [ "${attempt}" -lt 100 ]; do
    instrumentation_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --request POST --header 'Content-Type: application/json' \
      --header 'Sec-Fetch-Site: same-origin' \
      --data "{\"version\":1,\"template\":\"${instrumentation_key}\",\"bucket\":0,\"lcp_ms\":1200,\"inp_ms\":100,\"cls_milli\":50,\"dcl_ms\":500,\"load_ms\":700,\"errors\":0,\"rejections\":0,\"candidates\":[]}" \
      http://127.0.0.1:18081/.laghu/beacon/instrumentation)
    attempt=$((attempt + 1))
    [ "${instrumentation_status}" = 204 ] || sleep 0.1
  done
  [ "${instrumentation_status}" = 204 ] || {
    echo "Instrumentation beacon did not converge across Apache workers; last status: ${instrumentation_status}" >&2
    exit 1
  }
  beacon_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --request POST --header 'Content-Type: application/json' \
    --header 'Sec-Fetch-Site: same-origin' \
    --data '{"url":"/image.png","width":240,"height":240,"viewport_width":390,"dpr_hundredths":200,"above_fold":true,"mobile":true}' \
    http://127.0.0.1:18081/.laghu/beacon/images)
  [ "${beacon_status}" = 204 ]
  variant_file=$(find "${work}/cache" -name 'variant-*.bin' -type f | head -1)
  variant_key=${variant_file##*/variant-}
  variant_key=${variant_key%.bin}
  curl --fail --silent --dump-header "${work}/hashed-variant.headers" \
    "http://127.0.0.1:18081/.laghu/image/${variant_key}" \
    >"${work}/hashed-variant.bin"
  cmp "${variant_file}" "${work}/hashed-variant.bin"
  grep -i '^Cache-Control: public, max-age=31536000, immutable' \
    "${work}/hashed-variant.headers"
fi
if [ "${javascript_pid}" != "" ]; then
  kill "${javascript_pid}" 2>/dev/null || true
  wait "${javascript_pid}" 2>/dev/null || true
  javascript_pid=
fi

metrics_status=$(curl --silent --output "${work}/metrics.txt" --write-out '%{http_code}' \
  -H 'X-Laghu-Purge-Token: apache-purge-token-0123456789' \
  http://127.0.0.1:18081/.laghu/metrics)
if [ "${metrics_status}" != 200 ] || \
    ! grep 'laghu_requests_total' "${work}/metrics.txt" >/dev/null; then
  echo "Apache metrics endpoint failed with status ${metrics_status}:" >&2
  cat "${work}/metrics.txt" >&2
  exit 1
fi
readiness_status=$(curl --silent --output "${work}/readiness.json" --write-out '%{http_code}' \
  -H 'X-Laghu-Purge-Token: apache-purge-token-0123456789' \
  http://127.0.0.1:18081/.laghu/ready)
if [ "${readiness_status}" != 200 ] || \
    ! grep '"status":"ready"' "${work}/readiness.json" >/dev/null; then
  echo "Apache readiness endpoint failed with status ${readiness_status}:" >&2
  cat "${work}/readiness.json" >&2
  exit 1
fi

grep 'laghu_json={"schema":"laghu-log-v1"' "${work}/logs/error.log" >/dev/null
if grep -E 'smoke-test|apache-purge-token-0123456789|[?]laghu=' "${work}/logs/error.log" >/dev/null; then
  echo "Apache structured log leaked a secret or query." >&2
  exit 1
fi

trap - EXIT
kill -WINCH "${pid}" 2>/dev/null || kill "${pid}" 2>/dev/null || true
kill "${origin_pid}" 2>/dev/null || true
if [ "${service_pid}" != "" ]; then
  kill "${service_pid}" 2>/dev/null || true
fi
