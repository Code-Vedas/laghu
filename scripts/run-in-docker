set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
target=ubuntu-nginx
targets=
architectures=

command -v docker >/dev/null 2>&1 || {
  echo "Docker is required for scripts/run-in-docker." >&2
  exit 127
}

list_targets() {
  docker buildx bake --file "${REPO_ROOT}/docker-bake.hcl" --list=targets 2>/dev/null |
    awk 'NR > 1 && $1 != "base" && $1 != "default" { print $1 }'
}

run_chrome_isolation_canary() {
  image=$1
  worker=$2
  docker run --rm --privileged --network none \
    -e LAGHU_CHROME_CANARY_WORKER="${worker}" \
    --entrypoint /bin/sh "${image}" -ec '
    sentinel=/usr/local/share/laghu-chrome-analyze-host-canary.css
    chrome=/usr/lib/chromium/chromium
    worker=${LAGHU_CHROME_CANARY_WORKER}
    fixture=/workspace/tmp/build/workers/laghu-chrome-analyze/laghu_chrome_analyze_fixture
    test -x "${chrome}"
    test -x "${worker}"
    test -x "${fixture}"
    printf "%s\\n" ".outside-usr { color: black; }" >"${sentinel}"
    su --login --shell /bin/sh "${LAGHU_TEST_USER:-laghu-test}" --command \
      "cd /workspace && LAGHU_CHROME_ANALYSIS_ISOLATION_TEST=1 LAGHU_CHROME_ANALYSIS_USR_SENTINEL=${sentinel} python3 workers/laghu-chrome-analyze/tests/network_isolation_test.py ${worker} ${fixture} ${chrome}"
  '
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --list)
      list_targets
      exit 0
      ;;
    --target)
      [ "$#" -ge 2 ] || { echo "--target requires a name" >&2; exit 2; }
      target=$2
      shift 2
      ;;
    --all)
      targets=$(list_targets)
      shift
      ;;
    --architectures)
      [ "$#" -ge 2 ] || { echo "--architectures requires a list" >&2; exit 2; }
      architectures=$2
      shift 2
      ;;
    *)
      echo "usage: scripts/run-in-docker [--list | --target NAME | --all] [--architectures amd64,arm64]" >&2
      exit 2
      ;;
  esac
done

[ -n "${targets}" ] || targets=${target}
if [ -z "${architectures}" ]; then
  case "$(docker version --format '{{.Server.Arch}}')" in
    amd64|x86_64) architectures=amd64 ;;
    arm64|aarch64) architectures=arm64 ;;
    *) echo "Unsupported Docker architecture" >&2; exit 2 ;;
  esac
fi

results="${REPO_ROOT}/tmp/docker-tests"
mkdir -p "${results}"
failed=0
summary_files=
old_ifs=$IFS
IFS=,
for architecture in ${architectures}; do
  IFS=$old_ifs
  for current in ${targets}; do
    directory="${results}/${current}/${architecture}"
    mkdir -p "${directory}"
    summary_files="${summary_files} ${directory}/result"
    echo "==> ${current} (${architecture})"
    if docker buildx bake --load --file "${REPO_ROOT}/docker-bake.hcl" "${current}" \
        --set "${current}.platform=linux/${architecture}" \
        --set "${current}.tags=laghu-test:${current}-${architecture}" \
        --progress=plain >"${directory}/build.log" 2>&1; then
      cat "${directory}/build.log"
      case "${current}" in
        debian-nginx-chrome-analysis|debian-nginx-chrome-analysis-package-proof)
          chrome_worker=/usr/bin/laghu-chrome-analyze
          ;;
        debian-bookworm-chrome-isolation)
          chrome_worker=/workspace/tmp/build/workers/laghu-chrome-analyze/laghu-chrome-analyze
          ;;
        *) chrome_worker= ;;
      esac
      if [ -n "${chrome_worker}" ]; then
        if run_chrome_isolation_canary "laghu-test:${current}-${architecture}" "${chrome_worker}" >"${directory}/canary.log" 2>&1; then
          cat "${directory}/canary.log"
          printf '%s\n' PASS >"${directory}/result"
        else
          cat "${directory}/canary.log"
          printf '%s\n' FAIL >"${directory}/result"
          failed=1
        fi
      else
        printf '%s\n' PASS >"${directory}/result"
      fi
    else
      cat "${directory}/build.log"
      printf '%s\n' FAIL >"${directory}/result"
      failed=1
    fi
  done
  IFS=,
done
IFS=$old_ifs

echo "==> Docker test summary"
for result_file in ${summary_files}; do
  printf '%s\n' "${result_file}"
  cat "${result_file}"
done
exit "${failed}"
