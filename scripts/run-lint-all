# LICENSE file in the root directory of this source tree.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "${SCRIPT_DIR}/run-common"

run_cmd license-headers "${SCRIPT_DIR}/run-license-headers-all"

# This command is intentionally single-quoted so the inner shell expands it.
# shellcheck disable=SC2016
run_cmd shell-syntax sh -c '
  for script in "${1}"/scripts/*; do
    [ -f "${script}" ] || continue
    sh -n "${script}"
  done
  sh -n "${1}/packaging/debian/laghu-libvips.postinst"
' sh "${REPO_ROOT}"

run_cmd python-syntax env PYTHONPYCACHEPREFIX="${REPO_ROOT}/tmp/pycache" \
  "${PYTHON:-python3}" -m py_compile \
  "${REPO_ROOT}/workers/laghu-chrome-analyze/tests/analysis_test.py" \
  "${REPO_ROOT}/workers/laghu-libvips/tests/worker_test.py" \
  "${REPO_ROOT}/workers/laghu-html-refresh/tests/refresh_test.py"

if has_command shellcheck; then
  # SC1091 is disabled because the shared helper path is calculated at runtime.
  run_cmd shellcheck shellcheck -e SC1091 "${REPO_ROOT}"/scripts/*
else
  echo "Skipping shellcheck: shellcheck is not installed"
fi

clang_format=""
if has_command clang-format; then
  clang_format="clang-format"
elif has_command xcrun && xcrun --find clang-format >/dev/null 2>&1; then
  clang_format="$(xcrun --find clang-format)"
fi

if [ "${clang_format}" != "" ]; then
  runtime_test_sources=$(awk -F '|' -v root="${REPO_ROOT}" '
    $1 == "runtime_test" { print root "/" $3 }
  ' "${REPO_ROOT}/cmake/laghu-sources.list")
  if [ "${runtime_test_sources}" = "" ]; then
    echo "No runtime test sources registered" >&2
    exit 1
  fi
  # The manifest is repository-controlled and every source path is space-free.
  # shellcheck disable=SC2086
  run_cmd clang-format "${clang_format}" --dry-run --Werror \
    "${REPO_ROOT}"/libs/laghu-core/include/laghu/core.h \
    "${REPO_ROOT}"/libs/laghu-core/src/core.c \
    "${REPO_ROOT}"/libs/laghu-core/tests/core_test.c \
    "${REPO_ROOT}"/libs/laghu-core/tests/policy_fuzz.c \
    "${REPO_ROOT}"/libs/laghu-image/include/laghu/image.h \
    "${REPO_ROOT}"/libs/laghu-image/src/image.c \
    "${REPO_ROOT}"/libs/laghu-image/src/markup.c \
    "${REPO_ROOT}"/libs/laghu-image/src/css.c \
    "${REPO_ROOT}"/libs/laghu-image/tests/image_test.c \
    "${REPO_ROOT}"/libs/laghu-image/tests/image_fuzz.c \
    "${REPO_ROOT}"/libs/laghu-runtime/include/laghu/*.h \
    "${REPO_ROOT}"/libs/laghu-runtime/src/runtime_posix.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/queue.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/cache_artifact.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/persisted_state_wire.h \
    "${REPO_ROOT}"/libs/laghu-runtime/src/csp.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/budget.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/service_config.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/worker.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/log.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/catalog.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/asset.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/source.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/html.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/html_head.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/html_hints.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/lcp.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/css_runtime.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/css_catalog.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/css_markup.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/css_combine.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/css_imports.c \
    "${REPO_ROOT}"/libs/laghu-runtime/src/beacon.c \
    ${runtime_test_sources} \
    "${REPO_ROOT}"/libs/laghu-runtime/tests/runtime_fuzz.c \
    "${REPO_ROOT}"/libs/laghu-http/include/laghu/http.h \
    "${REPO_ROOT}"/libs/laghu-http/src/http.c \
    "${REPO_ROOT}"/libs/laghu-http/src/administrative.c \
    "${REPO_ROOT}"/libs/laghu-http/src/http_beacon.c \
    "${REPO_ROOT}"/libs/laghu-http/tests/http_test.c \
    "${REPO_ROOT}"/servers/laghu/include/laghu/proxy.h \
    "${REPO_ROOT}"/servers/laghu/src/proxy.c \
    "${REPO_ROOT}"/servers/laghu/src/request.c \
    "${REPO_ROOT}"/servers/laghu/src/administrative.c \
    "${REPO_ROOT}"/servers/laghu/src/admin_routes.c \
    "${REPO_ROOT}"/servers/laghu/src/beacon_routes.c \
    "${REPO_ROOT}"/servers/laghu/src/worker_pool.c \
    "${REPO_ROOT}"/servers/laghu/src/lifecycle.c \
    "${REPO_ROOT}"/servers/laghu/src/config.c \
    "${REPO_ROOT}"/servers/laghu/src/protocol.c \
    "${REPO_ROOT}"/servers/laghu/src/origin.c \
    "${REPO_ROOT}"/servers/laghu/src/transport.c \
    "${REPO_ROOT}"/servers/laghu/src/logging.c \
    "${REPO_ROOT}"/servers/laghu/src/server_internal.h \
    "${REPO_ROOT}"/servers/laghu/src/main.c \
    "${REPO_ROOT}"/servers/laghu/tests/proxy_test.c \
    "${REPO_ROOT}"/workers/laghu-asset-upload/main.c \
    "${REPO_ROOT}"/workers/laghu-chrome-analyze/main.c \
    "${REPO_ROOT}"/workers/laghu-chrome-analyze/tests/analysis_fixture.c \
    "${REPO_ROOT}"/workers/laghu-html-refresh/main.c \
    "${REPO_ROOT}"/workers/laghu-html-refresh/tests/refresh_fixture.c \
    "${REPO_ROOT}"/workers/laghu-libvips/main.c \
    "${REPO_ROOT}"/modules/mod_laghu/registration.c \
    "${REPO_ROOT}"/modules/mod_laghu/filtering.c \
    "${REPO_ROOT}"/modules/mod_laghu/endpoints.c \
    "${REPO_ROOT}"/modules/mod_laghu/admin_endpoints.c \
    "${REPO_ROOT}"/modules/mod_laghu/beacon_endpoints.c \
    "${REPO_ROOT}"/modules/mod_laghu/asset_endpoints.c \
    "${REPO_ROOT}"/modules/mod_laghu/configuration.c \
    "${REPO_ROOT}"/modules/mod_laghu/logging.c \
    "${REPO_ROOT}"/modules/mod_laghu/lifecycle.c \
    "${REPO_ROOT}"/modules/mod_laghu/mod_laghu_internal.h \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/ngx_http_laghu_module.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/filtering.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/transaction_adaptation.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/response_adaptation.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/logging.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/lifecycle.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/beacon.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/configuration.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/endpoints.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/admin_endpoints.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/beacon_endpoints.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/asset_endpoints.c \
    "${REPO_ROOT}"/modules/ngx_http_laghu_module/ngx_http_laghu_internal.h
else
  echo "Skipping clang-format: clang-format is not installed"
fi
