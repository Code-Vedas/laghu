"""Smoke a standalone laghu container against multiple upstream types."""

from __future__ import annotations

import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
import urllib.error
from pathlib import Path
from typing import Callable, Dict, Tuple


def free_port() -> int:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


def wait_http(url: str, timeout: float = 10.0) -> None:
    deadline = time.time() + timeout
    last_error: BaseException | None = None
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=1) as response:
                if response.status == 200:
                    return
        except urllib.error.HTTPError as error:
            last_error = error
        except OSError:
            last_error = None
            pass
        time.sleep(0.05)
    if last_error:
        raise AssertionError(f"server did not become ready: {url} ({type(last_error).__name__}: {last_error})")
    raise AssertionError(f"server did not become ready: {url}")


def request(
    url: str, headers: Dict[str, str] | None = None
) -> Tuple[int, Dict[str, str], bytes]:
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=5) as response:
        headers = {name.lower(): value for name, value in response.headers.items()}
        return response.status, headers, response.read()


def run_curl_request(
    url: str, headers: Dict[str, str] | None = None, args: list[str] | None = None
) -> Tuple[int, int, Dict[str, str], bytes]:
    args = args or []
    header_args = []
    for key, value in (headers or {}).items():
        header_args.extend(["-H", f"{key}: {value}"])
    with tempfile.NamedTemporaryFile(prefix="laghu-standalone-headers-", delete=False) as h:
        header_path = Path(h.name)
    with tempfile.NamedTemporaryFile(prefix="laghu-standalone-body-", delete=False) as b:
        body_path = Path(b.name)
    command = [
        "curl",
        "--fail",
        "--silent",
        "--show-error",
        *args,
        *header_args,
        "--dump-header",
        str(header_path),
        "--output",
        str(body_path),
        url,
    ]
    proc = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    status = 0
    headers = {}
    if header_path.exists():
        try:
            header_lines = header_path.read_text(errors="replace").splitlines()
            if header_lines and header_lines[0].startswith("HTTP/"):
                parts = header_lines[0].split(" ", 2)
                if len(parts) >= 2 and parts[1].isdigit():
                    status = int(parts[1])
            for line in header_lines:
                if not line or ": " not in line:
                    continue
                name, value = line.split(": ", 1)
                headers[name.lower()] = value
            if header_lines and header_lines[0].startswith("HTTP/"):
                headers[":protocol"] = header_lines[0].split(" ", 1)[0]
        except OSError:
            pass
    body = b""
    try:
        body = body_path.read_bytes()
    except OSError:
        body = b""
    finally:
        try:
            os.remove(str(header_path))
        except OSError:
            pass
        try:
            os.remove(str(body_path))
        except OSError:
            pass
    return proc.returncode, status, headers, body


def ensure_path(path: Path) -> None:
    if not path.exists():
        raise AssertionError(f"required artifact missing: {path}")


def curl_supports_http3() -> bool:
    if not shutil.which("curl"):
        return False
    return subprocess.run(
        ["curl", "--help", "all"], check=False, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    ).stdout.find("--http3") != -1


def start_h3_frontend(proxy_port: int, upstream_port: int, cache_root: Path) -> Tuple[subprocess.Popen[bytes], int, Callable[[], None]]:
    nginx = os.environ.get("LAGHU_H3_NGINX", shutil.which("nginx") or "")
    if not (shutil.which("openssl") and nginx and os.access(nginx, os.X_OK)):
        raise AssertionError("NGINX and OpenSSL are required for HTTP/3 proxy smoke checks.")

    cert_path = cache_root / "h3-cert.pem"
    key_path = cache_root / "h3-cert-key.pem"
    if (
        subprocess.run(
            [
                "openssl",
                "req",
                "-x509",
                "-nodes",
                "-newkey",
                "rsa:2048",
                "-keyout",
                str(key_path),
                "-out",
                str(cert_path),
                "-subj",
                "/CN=127.0.0.1",
                "-days",
                "1",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        != 0
    ):
        raise AssertionError("failed to generate standalone HTTP/3 test certificate")

    (cache_root / "logs").mkdir(exist_ok=True)
    (cache_root / "h3-client-body").mkdir(exist_ok=True)
    (cache_root / "h3-proxy-temp").mkdir(exist_ok=True)
    (cache_root / "h3-fastcgi-temp").mkdir(exist_ok=True)
    (cache_root / "h3-uwsgi-temp").mkdir(exist_ok=True)
    (cache_root / "h3-scgi-temp").mkdir(exist_ok=True)
    config = cache_root / "h3-fronted.conf"
    config.write_text(
        "\n".join(
            [
                f"pid {cache_root / 'logs' / 'h3-proxy.pid'};",
                f"error_log {cache_root / 'logs' / 'h3-proxy.log'} notice;",
                "events { }",
                "http {",
                f"  access_log {cache_root / 'logs' / 'h3-proxy.access.log'};",
                f"  client_body_temp_path {cache_root / 'h3-client-body'};",
                f"  proxy_temp_path {cache_root / 'h3-proxy-temp'};",
                f"  fastcgi_temp_path {cache_root / 'h3-fastcgi-temp'};",
                f"  uwsgi_temp_path {cache_root / 'h3-uwsgi-temp'};",
                f"  scgi_temp_path {cache_root / 'h3-scgi-temp'};",
                "  server {",
                f"    listen 127.0.0.1:{proxy_port} ssl;",
                f"    listen 127.0.0.1:{proxy_port} quic;",
                "    http2 on;",
                "    http3 on;",
                f"    ssl_certificate {cert_path};",
                f"    ssl_certificate_key {key_path};",
                "    ssl_protocols TLSv1.3;",
                "    server_name localhost;",
                "    location / {",
                "      proxy_buffering off;",
                "      proxy_http_version 1.1;",
                "      proxy_set_header Host $host;",
                f"      proxy_pass http://127.0.0.1:{upstream_port};",
                "    }",
                "  }",
                "}",
            ]
        )
    )
    process = subprocess.Popen(
        [nginx, "-c", str(config), "-g", "daemon off;"],
        cwd=str(cache_root),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    def stop() -> None:
        try:
            process.terminate()
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)

    return process, proxy_port, stop


def start_app_origin(root: Path) -> Tuple[subprocess.Popen[bytes], int, Callable[[], None]]:
    port = free_port()
    server = """import http.server
import os
import sys

class Handler(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header('ETag', '\"laghu-fixture-v1\"')
        super().end_headers()

os.chdir(sys.argv[2])
http.server.ThreadingHTTPServer(('127.0.0.1', int(sys.argv[1])), Handler).serve_forever()
"""
    process = subprocess.Popen(
        [
            sys.executable,
            "-c",
            server,
            str(port),
            str(root),
        ],
        cwd=str(root),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    def stop() -> None:
        try:
            process.terminate()
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)

    return process, port, stop


def start_nginx_origin(
    root: Path,
) -> Tuple[subprocess.Popen[bytes], int, Callable[[], None], Path]:
    if shutil.which("nginx") is None:
        raise AssertionError("nginx binary is required for nginx origin smoke")

    port = free_port()
    workdir = Path(tempfile.mkdtemp(prefix="laghu-nginx-origin-"))
    log_path = Path(tempfile.mkstemp(prefix=f"laghu-nginx-origin-{port}-", suffix=".log")[1])
    config = workdir / "nginx.conf"
    error_log_path = log_path.with_suffix(".error")
    config.write_text(
        "\n".join(
            [
                "worker_processes 1;",
                f"error_log {error_log_path} notice;",
                f"pid {workdir / 'nginx.pid'};",
                "events { worker_connections 128; }",
                "http {",
                "  include /etc/nginx/mime.types;",
                f"  access_log {log_path} combined;",
                "  server {",
                f"    listen 127.0.0.1:{port};",
                f"    root {root};",
                "    location / { try_files $uri $uri/ =404; }",
                "  }",
                "}",
                "",
            ]
        )
    )

    log_file = log_path.open("ab")
    process = subprocess.Popen(
        ["nginx", "-c", str(config), "-g", "daemon off;"],
        stdout=log_file,
        stderr=subprocess.STDOUT,
    )

    def stop() -> None:
        try:
            process.terminate()
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)
        log_file.close()

    return process, port, stop, log_path


def apache_module_path() -> Path:
    for candidate in (
        Path("/usr/lib/apache2/modules"),
        Path("/usr/lib64/httpd/modules"),
        Path("/usr/lib/httpd/modules"),
    ):
        if candidate.is_dir():
            return candidate
    return Path("/usr/lib/apache2/modules")


def apache_load_first_mpm(module_dir: Path) -> list[str]:
    loaded = []
    preferred = os.environ.get("APACHE_MPM")
    checks = (
        ("event", ".so", "mpm_event_module"),
        ("worker", ".so", "mpm_worker_module"),
        ("prefork", ".so", "mpm_prefork_module"),
    )

    if preferred:
        for name, suffix, directive in checks:
            if preferred != name:
                continue
            module = f"mod_mpm_{name}{suffix}"
            module_file = module_dir / module
            if module_file.exists():
                loaded.append(f"LoadModule {directive} {module_file}")
            return loaded

    for name, suffix, directive in checks:
        module = f"mod_mpm_{name}{suffix}"
        module_file = module_dir / module
        if module_file.exists():
            loaded.append(f"LoadModule {directive} {module_file}")
            return loaded
    return loaded


def start_apache_origin(
    root: Path,
) -> Tuple[subprocess.Popen[bytes], int, Callable[[], None], Path]:
    apache = shutil.which("apache2ctl") or shutil.which("apache2") or shutil.which("httpd")
    if apache is None:
        raise AssertionError("apache2/httpd binary is required for apache origin smoke")

    port = free_port()
    module_dir = apache_module_path()
    module_directives = [
        ("mod_authz_core.so", "authz_core_module"),
        ("mod_mime.so", "mime_module"),
        ("mod_alias.so", "alias_module"),
        ("mod_dir.so", "dir_module"),
        ("mod_log_config.so", "log_config_module"),
        ("mod_negotiation.so", "negotiation_module"),
        ("mod_unixd.so", "unixd_module"),
    ]
    load_modules = [*apache_load_first_mpm(module_dir)]
    for module, directive in module_directives:
        module_path = module_dir / module
        if module_path.exists():
            load_modules.append(f"LoadModule {directive} {module_path}")
    has_mime_types = Path("/etc/mime.types").exists()
    if has_mime_types:
        load_modules.append('TypesConfig "/etc/mime.types"')

    workdir = Path(tempfile.mkdtemp(prefix="laghu-apache-origin-"))
    config = workdir / "apache.conf"
    log_path = Path(tempfile.mkstemp(prefix=f"laghu-apache-origin-{port}-", suffix=".log")[1])
    config.write_text(
        "\n".join(
            [
                "ServerRoot /etc/apache2",
                f"PidFile {workdir}/apache.pid",
                "User www-data",
                "Group www-data",
                f"Listen 127.0.0.1:{port}",
                "ServerName localhost",
                f"ErrorLog {log_path}",
                "LogLevel warn",
                *load_modules,
                f"DocumentRoot {root}",
                "<Directory />",
                "  Require all denied",
                "</Directory>",
                f"<Directory {root}>",
                "  Options -Indexes +FollowSymLinks",
                "  AllowOverride None",
                "  Require all granted",
                "</Directory>",
                f"<VirtualHost 127.0.0.1:{port}>",
                "  ServerName localhost",
                f"  DocumentRoot {root}",
                "  DirectoryIndex index.html",
                "</VirtualHost>",
                "",
            ]
        )
    )

    log_file = log_path.open("ab")
    process = subprocess.Popen(
        [apache, "-f", str(config), "-DFOREGROUND"],
        stdout=log_file,
        stderr=subprocess.STDOUT,
    )

    def stop() -> None:
        try:
            process.terminate()
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)
        log_file.close()

    return process, port, stop, log_path


def start_origin(
    mode: str, root: Path
) -> Tuple[subprocess.Popen[bytes], int, Callable[[], None], Path | None]:
    if mode == "app":
        process, origin_port, stop_origin = start_app_origin(root)
        return process, origin_port, stop_origin, None
    if mode == "nginx":
        return start_nginx_origin(root)
    if mode == "apache":
        return start_apache_origin(root)
    raise AssertionError(f"unsupported origin mode: {mode}")


def has_laghu_header(headers: Dict[str, str]) -> bool:
    return any(key.startswith("x-laghu") for key in headers)


def has_origin_binary(mode: str) -> bool:
    if mode == "nginx":
        return shutil.which("nginx") is not None
    if mode == "apache":
        return (
            shutil.which("apache2ctl") is not None
            or shutil.which("apache2") is not None
            or shutil.which("httpd") is not None
        ) and (
            Path("/usr/lib/apache2/modules").is_dir()
            or Path("/usr/lib64/httpd/modules").is_dir()
            or Path("/usr/lib/httpd/modules").is_dir()
        )
    return True


def _read_text(path: Path | None, default: str = "") -> str:
    if path is None or not path.exists():
        return default
    return path.read_bytes().decode("utf-8", "replace")


def run_origin_mode(mode: str, executable: Path, optimizer: Path | None) -> None:
    root = Path(tempfile.mkdtemp(prefix=f"laghu-origin-{mode}-"))
    root.mkdir(parents=True, exist_ok=True)
    (root / "index.html").write_text(
        "<!doctype html><html><body><!-- remove -->" "hello "
        "compressible compressible compressible compressible compressible "
        "compressible compressible compressible compressible compressible "
        "compressible compressible compressible compressible compressible "
        "compressible compressible compressible compressible compressible "
        "<script src='/app.js'></script></body></html>",
        encoding="utf-8",
    )
    (root / "app.js").write_text(
        "function app(value){ return value + 1; }",
        encoding="utf-8",
    )
    (root / "h3.html").write_text(
        "<!doctype html><html><body><!-- remove -->h3"
        "<script src='/app.js'></script></body></html>",
        encoding="utf-8",
    )
    image_smoke = optimizer is not None and shutil.which("vips") is not None
    if image_smoke:
        source = root / "image.v"
        subprocess.run(["vips", "black", str(source), "512", "512", "--bands", "3"], check=True)
        subprocess.run(
            ["vips", "pngsave", str(source), str(root / "quality-image.png"), "--compression", "0"],
            check=True,
        )
        source.unlink()
    root.chmod(0o755)
    for filename in ("index.html", "h3.html", "app.js", "quality-image.png"):
        (root / filename).chmod(0o644)

    origin_process, origin_port, stop_origin, origin_log_path = start_origin(mode, root)
    try:
        if origin_process.poll() is not None:
            if origin_log_path and origin_log_path.exists():
                origin_logs = _read_text(origin_log_path)
                error_logs = _read_text(origin_log_path.with_suffix(".error"))
                details = ""
                if origin_logs:
                    details += f"ACCESS:\n{origin_logs}\n"
                if error_logs:
                    details += f"ERROR:\n{error_logs}\n"
                raise AssertionError(
                    f"origin process exited early for {mode}: code={origin_process.returncode} {details}".strip()
                )
            raise AssertionError(
                f"origin process exited early for {mode}: code={origin_process.returncode}"
            )
        try:
            wait_http(f"http://127.0.0.1:{origin_port}/index.html", timeout=30)
        except AssertionError:
            if origin_log_path and origin_log_path.exists():
                origin_logs = _read_text(origin_log_path)
                error_logs = _read_text(origin_log_path.with_suffix(".error"))
                details = ""
                if origin_logs:
                    details += f"ACCESS:\n{origin_logs}\n"
                if error_logs:
                    details += f"ERROR:\n{error_logs}\n"
                raise AssertionError(
                    f"origin server failed to start for {mode}: {details}"
                )
            raise AssertionError(
                f"server did not become ready for origin mode={mode}: "
                f"http://127.0.0.1:{origin_port}/index.html"
            )

        cache_root = Path(tempfile.mkdtemp(prefix=f"laghu-cache-{mode}-"))
        proxy_port = free_port()
        log_path = Path(tempfile.mkstemp(prefix=f"laghu-standalone-{mode}-", suffix=".log")[1])
        optimizer_process: subprocess.Popen[bytes] | None = None
        optimizer_log = None
        laghu_cmd = [
            str(executable),
            "--listen",
            f"127.0.0.1:{proxy_port}",
            "--origin",
            f"http://127.0.0.1:{origin_port}",
            "--cache",
            str(cache_root),
            "--html-cache-origin",
            "https://h3-cache.example.test",
            "--html-cache-ttl",
            "60",
            "--worker-queue",
            str(cache_root / "jobs.queue"),
            "--javascript-queue",
            str(cache_root / "javascript.queue"),
            "--allow-resources",
            "/*",
            "--disallow",
            "/never-optimized/*",
            "--query-filter-overrides",
            "on",
            "--rewrite-level",
            "all",
            "--workers",
            "1",
            "--connection-queue",
            "1",
        ]

        with log_path.open("ab") as log_file:
            proxy = subprocess.Popen(
                laghu_cmd,
                stdout=log_file,
                stderr=subprocess.STDOUT,
            )
        if image_smoke:
            optimizer_log = log_path.open("ab")
            optimizer_process = subprocess.Popen(
                [str(optimizer), "--init-and-serve", str(cache_root / "jobs.queue"), str(cache_root)],
                stdout=optimizer_log,
                stderr=subprocess.STDOUT,
            )

        try:
            wait_http(f"http://127.0.0.1:{proxy_port}/index.html", timeout=20)

            cold_status, cold_headers, cold_body = request(
                f"http://127.0.0.1:{proxy_port}/index.html"
            )
            if cold_status != 200:
                raise AssertionError(f"cold request failed for {mode}: status={cold_status}")
            if not cold_body:
                raise AssertionError(f"cold body empty for {mode}")

            warm_status, warm_headers, warm_body = request(
                f"http://127.0.0.1:{proxy_port}/index.html"
            )
            if warm_status != 200:
                raise AssertionError(f"warm request failed for {mode}: status={warm_status}")
            if not warm_body:
                raise AssertionError(f"warm body empty for {mode}")
            if "<!-- remove -->" in warm_body.decode("utf-8", "replace"):
                raise AssertionError(f"standalone {mode} origin did not warm HTML response")

            if not has_laghu_header(warm_headers):
                raise AssertionError(f"standalone {mode} origin missing laghu header")

            if image_smoke:
                avif_ready = False
                for _ in range(100):
                    avif_ret, avif_status, avif_headers, avif_body = run_curl_request(
                        f"http://127.0.0.1:{proxy_port}/quality-image.png",
                        headers={"Accept": "image/avif"},
                    )
                    if (
                        avif_ret == 0
                        and avif_status == 200
                        and avif_headers.get("x-laghu", "").lower() == "image-hit"
                        and avif_headers.get("content-type", "").lower().startswith("image/avif")
                        and "accept" in avif_headers.get("vary", "").lower()
                    ):
                        avif_ready = True
                        break
                    time.sleep(0.1)
                if not avif_ready:
                    raise AssertionError(f"standalone {mode} did not serve a warm AVIF image variant")
                with tempfile.NamedTemporaryFile(prefix="laghu-standalone-avif-", suffix=".avif") as image_file:
                    image_file.write(avif_body)
                    image_file.flush()
                    subprocess.run(["vipsheader", image_file.name], check=True, stdout=subprocess.DEVNULL)

                client_hint_ready = False
                for _ in range(100):
                    hint_ret, hint_status, hint_headers, hint_body = run_curl_request(
                        f"http://127.0.0.1:{proxy_port}/quality-image.png",
                        headers={"Accept": "image/avif", "Sec-CH-Viewport-Width": "128", "Sec-CH-DPR": "2"},
                    )
                    if (
                        hint_ret == 0
                        and hint_status == 200
                        and hint_headers.get("x-laghu", "").lower() == "image-hit"
                        and hint_headers.get("vary", "").lower()
                        == "accept, sec-ch-dpr, sec-ch-viewport-width"
                    ):
                        client_hint_ready = True
                        break
                    time.sleep(0.1)
                if not client_hint_ready:
                    raise AssertionError(f"standalone {mode} did not serve a client-hint image variant")
                with tempfile.NamedTemporaryFile(prefix="laghu-standalone-client-hint-", suffix=".avif") as image_file:
                    image_file.write(hint_body)
                    image_file.flush()
                    width = subprocess.run(
                        ["vipsheader", "-f", "width", image_file.name], check=True, capture_output=True, text=True
                    ).stdout.strip()
                    if width != "256":
                        raise AssertionError(f"standalone {mode} client-hint width was {width}, expected 256")

            for coding in ("br", "gzip"):
                encoded_ret, encoded_status, encoded_headers, encoded_body = run_curl_request(
                    f"http://127.0.0.1:{proxy_port}/index.html",
                    headers={"Accept-Encoding": coding},
                )
                if encoded_ret != 0 or encoded_status != 200:
                    raise AssertionError(f"standalone {mode} {coding} response failed")
                if encoded_headers.get("x-laghu-cache", "").lower() != "hit":
                    raise AssertionError(f"standalone {mode} {coding} was not a cache hit")
                if encoded_headers.get("content-encoding") != coding:
                    raise AssertionError(f"standalone {mode} did not select cached {coding}")
                if "accept-encoding" not in encoded_headers.get("vary", "").lower():
                    raise AssertionError(f"standalone {mode} {coding} response missing Vary")
                if not encoded_body:
                    raise AssertionError(f"standalone {mode} {coding} encoded body empty")

            curl_has_http3 = curl_supports_http3()
            if curl_has_http3:
                try:
                    _, h3_proxy_port, stop_h3_proxy = start_h3_frontend(
                        free_port(), proxy_port, cache_root
                    )
                except AssertionError:
                    print(f"Skipping standalone HTTP/3 smoke check for {mode}: missing nginx/openssl for H3 frontend.")
                else:
                    try:
                        try:
                            ready = False
                            for _ in range(60):
                                ret, h3_status, h3_headers, _ = run_curl_request(
                                    f"https://127.0.0.1:{h3_proxy_port}/index.html",
                                    args=["--http3", "--http3-only", "--insecure"],
                                )
                                if ret == 0 and h3_status == 200 and has_laghu_header(h3_headers):
                                    ready = True
                                    break
                                time.sleep(0.1)
                            if not ready:
                                h3_log_path = cache_root / "logs" / "h3-proxy.log"
                                h3_log = h3_log_path.read_text(errors="replace") if h3_log_path.exists() else "unavailable"
                                raise AssertionError(
                                    "standalone HTTP/3 proxy did not become ready for H3 smoke request: " + h3_log
                                )

                            cold_ret, cold_h3_status, h3_cold_headers, h3_cold_body = run_curl_request(
                                f"https://127.0.0.1:{h3_proxy_port}/h3.html",
                                args=["--http3", "--http3-only", "--insecure"],
                            )
                            if cold_ret != 0:
                                raise AssertionError(
                                    f"HTTP/3 cold request failed for {mode}: rc={cold_ret}"
                                )
                            if cold_h3_status != 200:
                                raise AssertionError(
                                    f"HTTP/3 cold request failed for {mode}: status={cold_h3_status}"
                                )
                            if h3_cold_headers.get(":protocol") != "HTTP/3":
                                raise AssertionError(
                                    f"HTTP/3 cold request did not negotiate HTTP/3 for {mode}"
                                )
                            if not h3_cold_body:
                                raise AssertionError(f"HTTP/3 cold body empty for {mode}")
                            if "x-laghu" not in h3_cold_headers:
                                raise AssertionError(
                                    f"HTTP/3 cold response missing Laghu header for {mode}"
                                )
                            cache_state = h3_cold_headers.get("x-laghu-cache", "")
                            if "miss" not in cache_state:
                                raise AssertionError(
                                    f"HTTP/3 cold response missing cache header for {mode}"
                                )
                            transform_state = h3_cold_headers.get("x-laghu-transform", "")
                            if "queued" not in transform_state:
                                raise AssertionError(
                                    f"HTTP/3 cold response missing queued transform state for {mode}"
                                )
                            if "<!-- remove -->" not in h3_cold_body.decode("utf-8", "replace"):
                                raise AssertionError(
                                    f"standalone {mode} HTTP/3 cold response did not preserve queued content"
                                )

                            warm_ready = False
                            for _ in range(200):
                                warm_ret, warm_h3_status, h3_warm_headers, h3_warm_body = run_curl_request(
                                    f"https://127.0.0.1:{h3_proxy_port}/h3.html",
                                    args=["--http3", "--http3-only", "--insecure"],
                                )
                                if warm_ret == 0 and warm_h3_status == 200 and "x-laghu-cache" in h3_warm_headers:
                                    if "hit" in h3_warm_headers.get("x-laghu-cache", ""):
                                        warm_ready = True
                                        break
                                time.sleep(0.1)
                            if not warm_ready:
                                raise AssertionError(
                                    f"HTTP/3 cold-to-warm cache transition not observed for {mode}"
                                )
                            if "x-laghu-transform" not in h3_warm_headers:
                                raise AssertionError(
                                    f"HTTP/3 warm response missing transform state for {mode}"
                                )
                            if "<!-- remove -->" in h3_warm_body.decode("utf-8", "replace"):
                                raise AssertionError(
                                    f"standalone {mode} HTTP/3 warm response retained removed content"
                                )
                        finally:
                            stop_h3_proxy()
                    except AssertionError:
                        raise
            else:
                print(f"Skipping standalone HTTP/3 smoke check for {mode}: curl --http3 unavailable.")

        finally:
            if proxy.poll() is None:
                proxy.terminate()
                proxy.wait(timeout=5)
            if optimizer_process is not None and optimizer_process.poll() is None:
                optimizer_process.terminate()
                optimizer_process.wait(timeout=5)
            if optimizer_log is not None:
                optimizer_log.close()

            logs = log_path.read_bytes().decode("utf-8", "replace")
            if '"schema":"laghu-log-v1"' not in logs:
                raise AssertionError(f"laghu logs not emitted for {mode}")
    finally:
        stop_origin()


def main() -> None:
    project_root = Path.cwd()
    build_dir = Path(os.environ.get("BUILD_DIR", project_root / "tmp" / "build"))
    executable = Path(
        os.environ.get(
            "LAGHU_EXE", str(build_dir / "servers" / "laghu" / "laghu")
        )
    )
    runtime_fixture = Path(
        os.environ.get(
            "LAGHU_RUNTIME_FIXTURE",
            str(build_dir / "libs" / "laghu-runtime" / "laghu_runtime_cache_fixture"),
        )
    )

    ensure_path(executable)
    ensure_path(runtime_fixture)
    optimizer = Path(
        os.environ.get(
            "LAGHU_OPTIMIZER_BIN", str(build_dir / "workers" / "laghu-libvips" / "laghu-libvips")
        )
    )
    if not optimizer.is_file() or not os.access(optimizer, os.X_OK) or not shutil.which("vips"):
        print("Skipping standalone AVIF smoke check: laghu-libvips or vips unavailable.")
        optimizer = None

    for mode in ("app", "nginx", "apache"):
        if not has_origin_binary(mode):
            print(f"Skipping standalone container smoke mode '{mode}': binary not available in environment.")
            continue
        run_origin_mode(mode, executable, optimizer)

    print("laghu standalone container origins smoke passed")


if __name__ == "__main__":
    main()
