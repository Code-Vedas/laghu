set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

"${SCRIPT_DIR}/run-lint-all"
"${SCRIPT_DIR}/run-build-all"
"${SCRIPT_DIR}/run-standalone-container-smoke"
"${SCRIPT_DIR}/run-test-all"

if [ "${SKIP_NGINX_MODULE_BUILD:-0}" != "1" ]; then
  "${SCRIPT_DIR}/run-module-build-all"
  "${SCRIPT_DIR}/run-module-smoke-all"
fi

if [ "${SKIP_APACHE_MODULE_BUILD:-0}" != "1" ] &&
    { command -v apxs >/dev/null 2>&1 || command -v apxs2 >/dev/null 2>&1; } &&
    { command -v httpd >/dev/null 2>&1 || command -v apache2 >/dev/null 2>&1; }; then
  "${SCRIPT_DIR}/run-apache-module-smoke-all"
fi

if [ "${SKIP_DOCS_BUILD:-0}" != "1" ]; then
  "${SCRIPT_DIR}/run-docs-build-all"
fi
