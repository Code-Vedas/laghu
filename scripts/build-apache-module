# This source code is licensed under the MIT license found in the
# LICENSE file in the root directory of this source tree.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
APXS=${APXS:-}

if [ -z "${APXS}" ]; then
  APXS=$(command -v apxs 2>/dev/null || command -v apxs2 2>/dev/null || true)
fi
if [ -z "${APXS}" ]; then
  echo "Apache apxs is required to build mod_laghu." >&2
  exit 127
fi

build_dir=${APACHE_BUILD_DIR:-"${REPO_ROOT}/tmp/apache-module"}
rm -rf "${build_dir}"
mkdir -p "${build_dir}"
cp "${REPO_ROOT}/modules/mod_laghu/mod_laghu_internal.h" \
  "${build_dir}/mod_laghu_internal.h"
set --
while IFS='|' read -r group alias source; do
  case "${group}" in ''|'#'*) continue ;; esac
  case "${group}" in
    base|markup|core|image|runtime|http|apache) ;;
    *) continue ;;
  esac
  cp "${REPO_ROOT}/${source}" "${build_dir}/${alias}"
  if [ "${alias}" = mod_laghu.c ]; then
    continue
  fi
  set -- "$@" "${alias}"
done < "${REPO_ROOT}/cmake/laghu-sources.list"
cp "${REPO_ROOT}/libs/laghu-runtime/src/rum_redis_merge.h" \
  "${build_dir}/rum_redis_merge.h"
cp "${REPO_ROOT}/libs/laghu-runtime/src/runtime_posix.c" \
  "${build_dir}/laghu_runtime.c"

cd "${build_dir}"
# Homebrew's Brotli headers are not necessarily in the compiler default path.
BROTLI_CFLAGS=$(pkg-config --cflags libbrotlienc 2>/dev/null || true)
BROTLI_LDFLAGS=$(pkg-config --libs-only-L libbrotlienc 2>/dev/null || true)
hardening_cflags=
hardening_ldflags=
if [ "$(uname -s)" = Linux ]; then
  hardening_cflags='-Wc,-fstack-protector-strong -Wc,-D_FORTIFY_SOURCE=3'
  hardening_ldflags='-Wl,-z,relro,-z,now'
fi
# shellcheck disable=SC2086
"${APXS}" -c \
  -Wc,-std=c11 \
  -Wc,-DLAGHU_HAVE_VIPS=0 \
  -I"${REPO_ROOT}/libs/laghu-base/include" \
  -I"${REPO_ROOT}/libs/laghu-markup/include" \
  -I"${REPO_ROOT}/libs/laghu-core/include" \
  -I"${REPO_ROOT}/libs/laghu-image/include" \
  -I"${REPO_ROOT}/libs/laghu-http/include" \
  -I"${REPO_ROOT}/libs/laghu-http/src" \
  -I"${REPO_ROOT}/libs/laghu-runtime/include" \
  -I"${REPO_ROOT}/libs/laghu-runtime/src" \
  ${hardening_cflags} \
  ${BROTLI_CFLAGS} \
  ${BROTLI_LDFLAGS} \
  ${hardening_ldflags} \
  -lz -lbrotlienc \
  mod_laghu.c "$@" \
  laghu_runtime.c

test -f "${build_dir}/.libs/mod_laghu.so"
