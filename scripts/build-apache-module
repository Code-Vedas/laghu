#!/bin/sh
# Copyright Codevedas Inc. 2026-present
#
# This source code is licensed under the MIT license found in the
# LICENSE file in the root directory of this source tree.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
APXS=${APXS:-}

if [ -z "${APXS}" ]; then
  APXS=$(command -v apxs 2>/dev/null || command -v apxs2 2>/dev/null || true)
fi
if [ -z "${APXS}" ]; then
  echo "Apache apxs is required to build mod_laghu." >&2
  exit 127
fi

build_dir=${APACHE_BUILD_DIR:-"${REPO_ROOT}/tmp/apache-module"}
rm -rf "${build_dir}"
mkdir -p "${build_dir}"
cp "${REPO_ROOT}/modules/mod_laghu/mod_laghu.c" "${build_dir}/mod_laghu.c"
cp "${REPO_ROOT}/libs/laghu-http/src/http.c" "${build_dir}/laghu_http.c"
cp "${REPO_ROOT}/libs/laghu-core/src/core.c" "${build_dir}/laghu_core.c"
cp "${REPO_ROOT}/libs/laghu-image/src/image.c" "${build_dir}/laghu_image.c"
cp "${REPO_ROOT}/libs/laghu-image/src/markup.c" "${build_dir}/laghu_markup.c"
cp "${REPO_ROOT}/libs/laghu-image/src/css.c" "${build_dir}/laghu_image_css.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/catalog.c" "${build_dir}/laghu_catalog.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/asset.c" "${build_dir}/laghu_asset.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/cache.c" "${build_dir}/laghu_cache.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/html.c" "${build_dir}/laghu_html.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/html_head.c" "${build_dir}/laghu_html_head.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/html_hints.c" "${build_dir}/laghu_html_hints.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/css_runtime.c" "${build_dir}/laghu_runtime_css.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/css_catalog.c" "${build_dir}/laghu_css_catalog.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/css_combine.c" "${build_dir}/laghu_css_combine.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/css_imports.c" "${build_dir}/laghu_css_imports.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/css_markup.c" "${build_dir}/laghu_css_markup.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/critical_css.c" "${build_dir}/laghu_critical_css.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/instrumentation.c" "${build_dir}/laghu_instrumentation.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/rum.c" "${build_dir}/laghu_rum.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/rum_redis_merge.h" \
  "${build_dir}/rum_redis_merge.h"
cp "${REPO_ROOT}/libs/laghu-runtime/src/font_provider.c" "${build_dir}/laghu_font_provider.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/javascript.c" "${build_dir}/laghu_javascript.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/javascript_defer.c" "${build_dir}/laghu_javascript_defer.c"
cp "${REPO_ROOT}/libs/laghu-runtime/src/beacon.c" "${build_dir}/laghu_beacon.c"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    cp "${REPO_ROOT}/libs/laghu-runtime/src/runtime_win32.c" \
      "${build_dir}/laghu_runtime.c"
    ;;
  *)
    cp "${REPO_ROOT}/libs/laghu-runtime/src/runtime_posix.c" \
      "${build_dir}/laghu_runtime.c"
    ;;
esac

cd "${build_dir}"
"${APXS}" -c \
  -Wc,-std=c11 \
  -Wc,-DLAGHU_HAVE_VIPS=0 \
  -I"${REPO_ROOT}/libs/laghu-core/include" \
  -I"${REPO_ROOT}/libs/laghu-image/include" \
  -I"${REPO_ROOT}/libs/laghu-http/include" \
  -I"${REPO_ROOT}/libs/laghu-runtime/include" \
  mod_laghu.c \
  laghu_http.c \
  laghu_core.c \
  laghu_image.c \
  laghu_markup.c \
  laghu_image_css.c \
  laghu_catalog.c \
  laghu_asset.c \
  laghu_cache.c \
  laghu_html.c \
  laghu_html_head.c \
  laghu_html_hints.c \
  laghu_runtime_css.c \
  laghu_css_catalog.c \
  laghu_css_combine.c \
  laghu_css_imports.c \
  laghu_css_markup.c \
  laghu_critical_css.c \
  laghu_instrumentation.c \
  laghu_rum.c \
  laghu_font_provider.c \
  laghu_javascript.c \
  laghu_javascript_defer.c \
  laghu_beacon.c \
  laghu_runtime.c

test -f "${build_dir}/.libs/mod_laghu.so"
