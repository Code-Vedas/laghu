set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${SCRIPT_DIR}/run-common"

BUILD_DIR="${BUILD_DIR:-${REPO_ROOT}/tmp/build}"

run_cmd core-configure cmake \
  -S "${REPO_ROOT}" \
  -B "${BUILD_DIR}" \
  -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Debug}" \
  -DLAGHU_WITH_VIPS="${LAGHU_WITH_VIPS:-AUTO}"
run_cmd core-build cmake --build "${BUILD_DIR}" --parallel
