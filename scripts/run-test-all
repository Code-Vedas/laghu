set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${SCRIPT_DIR}/run-common"

BUILD_DIR="${BUILD_DIR:-${REPO_ROOT}/tmp/build}"

if [ ! -f "${BUILD_DIR}/CTestTestfile.cmake" ]; then
  "${SCRIPT_DIR}/run-build-all"
fi

run_cmd core-test ctest --test-dir "${BUILD_DIR}" --output-on-failure

