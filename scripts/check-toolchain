#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

usage() {
  printf '%s\n' 'usage: scripts/check-toolchain --cxx <compiler> --out <build-directory>' >&2
  exit 64
}

require_value() { [ "$#" -ge 2 ] && [ -n "$2" ] || usage; }

cxx=
out=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cxx) require_value "$@"; cxx=$2; shift 2 ;;
    --out) require_value "$@"; out=$2; shift 2 ;;
    *) usage ;;
  esac
done

[ -n "$cxx" ] && [ -n "$out" ] || usage
command -v "$cxx" >/dev/null 2>&1 || {
  printf 'error: Laghu toolchain check cannot find compiler: %s\n' "$cxx" >&2
  exit 69
}
command -v cmake >/dev/null 2>&1 || { printf '%s\n' 'error: Laghu toolchain check requires CMake' >&2; exit 69; }
command -v ninja >/dev/null 2>&1 || { printf '%s\n' 'error: Laghu toolchain check requires Ninja' >&2; exit 69; }

cmake -S . -B "$out" -G Ninja -DCMAKE_CXX_COMPILER="$cxx"
cmake --build "$out" --target laghu_verify_toolchain
