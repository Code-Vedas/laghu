set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${SCRIPT_DIR}/run-common"

run_cmd docs-build sh -c '
  cd "${1}/docs"
  bundle check >/dev/null 2>&1 || bundle install
  bundle exec jekyll build
' sh "${REPO_ROOT}"

