set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
case "$(uname -m)" in x86_64|amd64) ;; *) echo 'Frozen ngx_pagespeed benchmark is AMD64-only.' >&2; exit 2 ;; esac
command -v docker >/dev/null 2>&1 || { echo 'Docker is required.' >&2; exit 2; }
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
output="${LAGHU_BENCH_OUTPUT:-${REPO_ROOT}/tmp/benchmarks/${timestamp}}"
corpus="${LAGHU_BENCH_CORPUS:-${output}/corpus}"
mkdir -p "${output}"
if [ -n "${LAGHU_BENCH_CORPUS:-}" ]; then
  [ -f "${corpus}/manifest.json" ] || { echo 'LAGHU_BENCH_CORPUS must contain manifest.json.' >&2; exit 2; }
else
  python3 "${REPO_ROOT}/performance/generate_corpus.py" --output "${corpus}"
fi
docker build --tag laghu-bench-quality:local --file "${REPO_ROOT}/performance/Dockerfile.quality" "${REPO_ROOT}/performance"
docker build --tag laghu-bench-lighthouse:local --file "${REPO_ROOT}/performance/Dockerfile.lighthouse" "${REPO_ROOT}/performance"
LAGHU_BENCH_CORPUS="${corpus}" docker compose --project-directory "${REPO_ROOT}/performance" -f "${REPO_ROOT}/performance/docker-compose.yml" up --build --detach
cleanup() { LAGHU_BENCH_CORPUS="${corpus}" docker compose --project-directory "${REPO_ROOT}/performance" -f "${REPO_ROOT}/performance/docker-compose.yml" down --volumes; }
trap cleanup EXIT HUP INT TERM
attempt=0
while [ "${attempt}" -lt 60 ]; do
  if curl --fail --silent http://127.0.0.1:18090/index.html >/dev/null && curl --fail --silent http://127.0.0.1:18091/index.html >/dev/null && curl --fail --silent http://127.0.0.1:18092/index.html >/dev/null; then break; fi
  attempt=$((attempt + 1)); sleep 1
done
[ "${attempt}" -lt 60 ] || { echo 'Benchmark target readiness timed out.' >&2; exit 1; }
python3 "${REPO_ROOT}/performance/run_benchmark.py" --output "${output}" --corpus "${corpus}"
printf '%s\n' "${output}"
