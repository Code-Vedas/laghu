set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
case "$(uname -m)" in x86_64|amd64) ;; *) echo 'Frozen ngx_pagespeed benchmark is AMD64-only.' >&2; exit 2 ;; esac
command -v docker >/dev/null 2>&1 || { echo 'Docker is required.' >&2; exit 2; }
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
output="${LAGHU_BENCH_OUTPUT:-${REPO_ROOT}/tmp/benchmarks/${timestamp}}"
corpus="${LAGHU_BENCH_CORPUS:-${output}/corpus}"
mkdir -p "${output}"
if [ -n "${LAGHU_BENCH_CORPUS:-}" ]; then
  [ -f "${corpus}/manifest.json" ] || { echo 'LAGHU_BENCH_CORPUS must contain manifest.json.' >&2; exit 2; }
else
  python3 "${REPO_ROOT}/performance/generate_corpus.py" --output "${corpus}"
fi
compose() {
  LAGHU_BENCH_CORPUS="${corpus}" docker compose \
    --project-directory "${REPO_ROOT}/performance" \
    -f "${REPO_ROOT}/performance/docker-compose.yml" "$@"
}
cleanup() { compose down --volumes; }
trap cleanup EXIT HUP INT TERM
compose down --volumes --remove-orphans >/dev/null 2>&1 || true
compose up --build --detach
set -- --output "${output}" --corpus "${corpus}"
if [ "${LAGHU_BENCH_FULL:-0}" = 1 ]; then set -- "$@" --full; fi
python3 "${REPO_ROOT}/performance/run_k6_rail.py" "$@"
printf '%s\n' "${output}"
