set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)

NGINX_VERSION="${NGINX_VERSION:-1.30.4}"
NGINX_HTTP3="${NGINX_HTTP3:-0}"
WORK_DIR="${NGINX_WORK_DIR:-${REPO_ROOT}/tmp/nginx/${NGINX_VERSION}}"
SOURCE_DIR="${NGINX_SOURCE_DIR:-${WORK_DIR}/source}"
BUILD_DIR="${NGINX_BUILD_DIR:-${WORK_DIR}/build}"
MODULE_DIR="${NGINX_MODULE_DIR:-${REPO_ROOT}/modules/ngx_http_laghu_module}"
TAR="${TAR:-tar}"
LOCK_DIR="${NGINX_BUILD_LOCK_DIR:-${WORK_DIR}/.laghu-build.lock}"
lock_held=0

release_lock() {
  if [ "${lock_held}" = 1 ]; then
    rm -f "${LOCK_DIR}/pid"
    rmdir "${LOCK_DIR}" 2>/dev/null || true
  fi
}

trap release_lock EXIT
trap 'exit 1' HUP INT TERM

mkdir -p "${WORK_DIR}"

while ! mkdir "${LOCK_DIR}" 2>/dev/null; do
  if [ -f "${LOCK_DIR}/pid" ]; then
    read -r lock_pid <"${LOCK_DIR}/pid" || lock_pid=""
    case "${lock_pid}" in
      *[!0-9]*|'') ;;
      *)
        if ! kill -0 "${lock_pid}" 2>/dev/null; then
          rm -f "${LOCK_DIR}/pid"
          rmdir "${LOCK_DIR}" 2>/dev/null || true
          continue
        fi
        ;;
    esac
  fi
  sleep 1
done
lock_held=1
printf '%s\n' "$$" >"${LOCK_DIR}/pid"

if [ ! -x "${SOURCE_DIR}/configure" ]; then
  archive="${WORK_DIR}/nginx-${NGINX_VERSION}.tar.gz"
  unpacked="${WORK_DIR}/nginx-${NGINX_VERSION}"

  command -v curl >/dev/null 2>&1 || {
    echo "curl is required to download NGINX ${NGINX_VERSION}." >&2
    exit 127
  }

  curl --fail --location --retry 3 \
    --output "${archive}" \
    "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz"
  rm -rf "${unpacked}" "${SOURCE_DIR}"
  "${TAR}" -xzf "${archive}" -C "${WORK_DIR}"
  mv "${unpacked}" "${SOURCE_DIR}"
fi

rm -rf "${BUILD_DIR}"
mkdir -p "${BUILD_DIR}"

(
  cd "${SOURCE_DIR}"
  set -- ./configure \
    --builddir="${BUILD_DIR}" \
    --with-compat \
    --with-http_v2_module \
    --add-dynamic-module="${MODULE_DIR}"
  if [ "${NGINX_HTTP3}" = 1 ]; then
    set -- "$@" --with-http_v3_module
  fi
  "$@"
  make -f "${BUILD_DIR}/Makefile" "${MAKE_JOBS:--j2}"
)

artifact="${BUILD_DIR}/ngx_http_laghu_module.so"
if [ ! -f "${artifact}" ]; then
  echo "Expected module artifact was not produced: ${artifact}" >&2
  exit 1
fi

echo "Built ${artifact}"
