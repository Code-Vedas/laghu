#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

[ "$#" -eq 1 ] || { printf '%s\n' 'usage: scripts/audit-warning-invocations <invocation-trace>' >&2; exit 64; }
[ -r "$1" ] || { printf 'error: Laghu warning-gate cannot read invocation trace: %s\n' "$1" >&2; exit 66; }

tab=$(printf '\t')
while IFS="$tab" read -r target source flags; do
  [ -n "$target" ] || continue
  [ -n "$source" ] && [ -n "$flags" ] || {
    printf 'error: Laghu warning-gate malformed invocation: target=%s\n' "$target" >&2
    exit 1
  }
  case "$target" in
    laghu-first-party) ;;
    third-party)
      case " $flags " in
        *' -W'*)
          printf 'error: Laghu warning-gate third-party flags leaked: source=%s\n' "$source" >&2
          exit 1
          ;;
      esac
      ;;
    *)
      printf 'error: Laghu warning-gate unknown invocation target: %s\n' "$target" >&2
      exit 1
      ;;
  esac
done <"$1"
